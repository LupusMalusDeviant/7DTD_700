<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_40_Bauen / blocks.xml
	     F-04 Werkstaetten, Plan-0001 WP4.3 und WP4.5

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     Die fuenf Vanilla-Werkstaetten werden UMGEDEUTET, nicht neu gebaut. F-04 ordnet
	     zu:

	       campfire          -> Feuerstelle
	       workbench         -> Zimmermannsbank
	       forge             -> Rennofen UND Esse, getrennt durch das Werkzeug
	       chemistryStation  -> Kraeuterkueche
	       cementMixer       -> Kalkofen

	     Der sichtbare Teil der Umdeutung ist Sprache und steht in
	     mod/700_90_Sprache/Config/Localization.csv. Hier steht nur, was Verhalten ist -
	     und das ist genau eine Zeile. -->

	<!-- WP4.5: Der Kalkofen braucht Feuer. F-04 nennt fuer ihn "Holz/Holzkohle", aber
	     Vanillas Betonmischer hat 'Modules="output"' und damit keine Brennstoffkammer -
	     er ruehrt, er brennt nicht. Kalk wird gebrannt, also bekommt er eine. Dieselbe
	     Zeile macht aus einer elektrisch gedachten Maschine einen Ofen, ohne dass ein
	     neuer Block noetig ist.

	     Das Fenster dazu steht in XUi_InGame/xui.xml: ein Modul ohne sein Fenster waere
	     eine Kammer, die der Spieler nicht sehen kann. Beide Zeilen gehoeren zusammen. -->
	<set xpath="/blocks/block[@name='cementMixer']/property[@class='Workstation']/property[@name='Modules']/@value">output,fuel</set>

	<!-- ===========================================================================
	     DER WEBSTUHL (D57, Plan-0001 WP5.5b, F-03 und F-04)
	     ===========================================================================

	     Der erste eigene Block des Projekts. Er stand in WP4.4 und ist mit D57 hierher
	     gewandert, weil er mit resourceCloth allein EIN Rezept gehabt haette und keinen
	     Zweck; erst die Gambeson-Teile aus T2 fuellen ihn. Jetzt traegt er fuenf
	     Rezepte - Steppbahn und die vier Gambeson-Teile - und erfuellt damit F-04s
	     Kriterium "mindestens fuenf Rezepte".

	     VOLL AUSGESCHRIEBEN, OHNE Extends. Vanillas workbench waere die naheliegende
	     Grundlage, aber sie bringt zwei Dinge mit, die wir nicht wollen: 'RepairItems'
	     mit resourceMechanicalParts und Bergungs-Drops mit denselben gesperrten
	     Kennungen. Geerbt wuerde beides, und wie sich eine neu deklarierte drop-Liste
	     gegen die geerbte verhaelt, ist nicht gemessen. Darum steht hier jede
	     Eigenschaft ausdruecklich - abgeschrieben von workbench, mit unseren Werten.

	     DAS FENSTER STEHT IN XUi_InGame/xui.xml. Das Spiel sucht die Fenstergruppe
	     'workstation_<Blockname>', also 'workstation_blk700_webstuhl'. Es gibt in
	     V 3.40 EINEN kuerzeren Weg - 'WorkstationWindow' zeigt auf eine fremde Gruppe,
	     tableSaw macht das so -, aber tableSaw ist unfertiger Vanilla-Inhalt
	     (CreativeMode="Dev", Bau-Rezept auskommentiert) und die Eigenschaft kommt in
	     ganz blocks.xml genau einmal vor. Fuenf von fuenf Werkstaetten, die wirklich
	     laufen, haben ihre eigene Gruppe. Wir nehmen den Weg, der laeuft.

	     DAS MODELL IST GEBORGT UND SIEHT AUS WIE DIE ZIMMERMANNSBANK. Vanilla hat
	     keinen Webstuhl; von den Prefabs unter Entities/Crafting ist die Holzwerkbank
	     das einzige Stueck Holzmoebel, das nicht Saegeblatt, Kessel oder
	     Getraenkeautomat ist. Zwei Werkstaetten mit demselben Koerper sind im Spiel
	     verwirrend - ein eigenes Modell steht in Phase 2 (D3, F-16), bis dahin
	     unterscheiden sie Name, Symbol und Inhalt.
	-->
	<append xpath="/blocks">

		<block name="blk700_webstuhl">
			<property name="Class" value="Workstation" />
			<property class="Workstation">
				<property name="Modules" value="output" />
				<property name="CraftingAreaRecipes" value="webstuhl" />
			</property>

			<property name="CreativeMode" value="Player" />
			<property name="DescriptionKey" value="blk700_webstuhlDesc" />
			<property name="DisplayType" value="blockMulti" />
			<property name="WorkstationIcon" value="ui_game_symbol_workbench" />
			<property name="CraftIcon" value="ui_game_symbol_workbench" />
			<property name="Stacknumber" value="1" />

			<property name="Material" value="Mwood" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Crafting/woodWorkBenchPrefab.prefab" />
			<property name="ModelOffset" value="0,.5,0" />
			<property name="MultiBlockDim" value="2,2,1" />
			<property name="ImposterDontBlock" value="true" />
			<property name="WaterFlow" value="permitted" />

			<property name="Place" value="TowardsPlacerInverted" />
			<property name="OnlySimpleRotations" value="true" />
			<property name="IsTerrainDecoration" value="true" />
			<property name="StabilitySupport" value="false" />

			<property name="Weight" value="0" />
			<property name="EconomicValue" value="600" />

			<property name="MaxDamage" value="500" />
			<property name="OpenSound" value="open_workbench" />
			<property name="CloseSound" value="close_workbench" />
			<property name="TakeDelay" value="15" />

			<!-- Geflickt wird er mit Holz und Faden, nicht mit Maschinenteilen. -->
			<property class="RepairItems">
				<property name="resourceWood" value="30" />
				<property name="resourceYuccaFibers" value="20" />
			</property>

			<drop event="Harvest" name="resourceWood" count="20" tag="allHarvest,lumberjackHarvest,perkJunkMiner" />
			<drop event="Harvest" name="resourceYuccaFibers" count="10" tag="salvageHarvest" />
			<drop event="Destroy" count="0" />
			<drop event="Fall" name="terrDestroyedWoodDebris" count="1" prob="0.75" stick_chance="1" />

			<property name="SortOrder1" value="B281" />
			<property name="SortOrder2" value="0310" />
			<property name="Group" value="Limited,Building,advBuilding" />
			<property name="Tags" value="workstationSkill" />
			<property name="FilterTags" value="MC_playerBlocks,SC_decor" />
			<property name="SoundPickup" value="workbench_grab" />
			<property name="SoundPlace" value="workbench_place" />
		</block>

	</append>

	<!-- KEIN WERKZEUGSLOT, UND DAS IST EINE ABWEICHUNG VON F-04. Die F-04-Tabelle gibt
	     dem Webstuhl ein "Weberschiffchen" als Werkzeug. Ein Werkzeugslot ist kein
	     Blockeintrag, sondern ein eigenes XUi-Werkzeugfenster plus ein Gegenstand plus
	     eine Zeile 'Modules="output,tools"' - und Werkzeugfenster werden in Vanilla
	     ueber 'required_tools' an einem Gitter gefuehrt, das je Werkstatt eigens
	     definiert ist (siehe XUi_InGame/windows.xml). Das sind drei Dinge fuer eine
	     Feinheit, die kein Rezept der Phase 1 braucht: alle fuenf Webstuhl-Rezepte
	     laufen ohne Werkzeug. Vermerkt in F-04 als offener Punkt, nicht still
	     weggelassen. -->

	<!-- NICHT GEMACHT, UND WARUM. F-04 gibt der Zimmermannsbank Saege, Hobel und Bohrer
	     und der Esse zusaetzlich Zange und Hammer. Das sind fuenf neue Gegenstaende und
	     zwei neue XUi-Werkzeugfenster - also Inhalt, und Inhalt gehoert in das Paket,
	     das ihn braucht (D50). Die Zimmermannsbank bleibt darum bei 'Modules="output"',
	     und die Esse behaelt Vanillas drei Slots (Blasebalg, Amboss, Schmelztiegel), die
	     F-04 ohnehin nennt und die fuer die Kette aus WP4.6 ausreichen.

	     Ebenfalls offen: 'CraftActionName' heisst am Kalkofen weiter 'lblContextActionMix'
	     ("Mischen") statt "Brennen". Der Schluessel gehoert Vanilla und wird auch von der
	     Kraeuterkueche benutzt; ihn zu ueberschreiben wuerde beide treffen. Ein eigener
	     Schluessel je Werkstatt waere richtig und ist eine Zeile mehr, als WP4.5
	     verlangt - vermerkt fuer F-12 in WP8, wo die Sprache ohnehin durchgesehen wird. -->

	<!-- ================================================================================
	     F-18 AUSBAUPFAD, Plan-0001 WP6.1, D63

	     Rahmen -> Flechtwerk -> Fachwerk -> Bruchstein -> Moertelstein.

	     GEMESSEN: der ganze Pfad haengt an FUENF Bloecken mit shapes="All", und jeder
	     zeigt mit einem UpgradeBlock auf den naechsten. Die Zuordnung ist die
	     Reihenfolge der Haltbarkeit ihrer Materialien, nichts sonst:

	       frameShapes        Mwood_weak_shapes     MaxDamage   100   Rahmen
	       woodShapes         Mwood_shapes          MaxDamage   500   Flechtwerk
	       cobblestoneShapes  Mcobblestone_shapes   MaxDamage  1500   Fachwerk
	       concreteShapes     Mconcrete_shapes      MaxDamage  5000   Bruchstein
	       steelShapes        Msteel_shapes         MaxDamage 10000   Moertelstein

	     Jedes dieser Materialien hat GENAU EINEN Block, der es benutzt - geprueft mit
	     grep ueber blocks.xml. Eine Aenderung am Material trifft also nur seine
	     Baustufe und nichts anderes.

	     'Fachwerk' auf dem Pflasterstein ist die schwaechste Stelle der Zuordnung, und
	     sie ist trotzdem die richtige: Vanillas resourceCobblestones entsteht aus
	     1 Lehm + 1 Stein, und das ist die Ausfachung eines Fachwerks. Haltbarkeit
	     zwischen Flechtwand und Steinmauer passt dazu.

	     WAS GEAENDERT WIRD, und was nicht:

	       Rahmen -> Flechtwerk     8 Holz             UNVERAENDERT, Flechtwerk ist Holz
	       Flechtwerk -> Fachwerk  10 Pflasterstein    UNVERAENDERT, siehe oben
	       Fachwerk -> Bruchstein  10 Moertel  ->  25 Bruchstein (resourceRockSmall)
	       Bruchstein -> Moertelst. 10 Schmiedestahl -> 10 Moertel (resourceConcreteMix)

	     Bruchstein wird TROCKEN gesetzt, darum Stein und kein Moertel; der Moertel ist
	     genau der Unterschied zur obersten Stufe. Die 25 sind nicht gewuerfelt: so viele
	     Steine gibt concreteShapes beim Abbau selbst her, der Ausbau kostet also das,
	     was der Block wiegt.

	     UpgradeBlock nimmt GENAU EINE Zutat (ein 'Item', ein 'ItemCount') - gemessen an
	     allen neun Pfad- und Spiessbloecken. Mehrstoffige Stufen, wie F-18 sie sich
	     wuenscht, brauchen darum einen Zwischengegenstand; hier ist das der Moertel, und
	     den gibt es nach D63 schon: Vanillas resourceConcreteMix vom Kalkofen aus
	     Sand + Stein + Branntkalk. -->

	<set xpath="/blocks/block[@name='cobblestoneShapes']/property[@class='UpgradeBlock']/property[@name='Item']/@value">resourceRockSmall</set>
	<set xpath="/blocks/block[@name='cobblestoneShapes']/property[@class='UpgradeBlock']/property[@name='ItemCount']/@value">25</set>

	<set xpath="/blocks/block[@name='concreteShapes']/property[@class='UpgradeBlock']/property[@name='Item']/@value">resourceConcreteMix</set>

	<!-- Reparatur folgt derselben Logik: trockener Bruchstein mit Stein, Moertelstein mit
	     Moertel. Vanilla flickte den einen mit Betonmischung und den anderen mit
	     Schmiedestahl. -->
	<set xpath="/blocks/block[@name='concreteShapes']/property[@class='RepairItems']/property[@name='resourceConcreteMix']/@name">resourceRockSmall</set>
	<set xpath="/blocks/block[@name='steelShapes']/property[@class='RepairItems']/property[@name='resourceForgedSteel']/@name">resourceConcreteMix</set>

	<!-- Moertelstein gibt beim Abbau Stein her, nicht Alteisen. Vanillas steelShapes
	     wirft 15 resourceScrapIron ab - das ist die einzige Stelle im Pfad, an der der
	     Abbau noch verraet, dass der Block einmal Stahl war.

	     Die Stueckzahl wird ZUERST gesetzt, dann der Name: danach heisst der Abwurf
	     nicht mehr resourceScrapIron, und der zweite XPath wuerde ins Leere greifen. -->
	<set xpath="/blocks/block[@name='steelShapes']/drop[@event='Harvest'][@name='resourceScrapIron']/@count">20</set>
	<set xpath="/blocks/block[@name='steelShapes']/drop[@event='Harvest'][@name='resourceScrapIron']/@name">resourceRockSmall</set>

	<!-- ================================================================================
	     F-08 LICHT, DAS AUSGEHT, Plan-0001 WP6.4 und WP6.5, D64

	     VIER LICHTQUELLEN, drei davon Vanilla umgedeutet, eine neu:

	       wallTorchLightPlayer      Wandfackel        ~30 min
	       candleWallLightPlayer     Unschlittkerze    ~15 min   (Wand)
	       candleTableLightPlayer    Unschlittkerze    ~15 min   (Tisch, erbt)
	       lanternOld_01..04_Player  Oellampe          ~60 min
	       blk700_holzfeuer          Holzfeuer         ~45 min   (neu)

	     WIE DAS GEHT. 'Class="PlantGrowing"' ist in V 3.40 der einzige Weg, einen Block
	     per XML nach einer Zeit in einen anderen zu verwandeln - gemessen an allen 50
	     Block-Klassen; 'TriggerDowngrade' ist ereignisgesteuert (eine POI-Gasleitung),
	     alles andere hat keine Uhr. Zustand und Netzsynchronisierung erledigt damit das
	     Spiel.

	     DIE DREI TORE MUESSEN ALLE AUF 0. FertileLevel, LightLevelStay und LightLevelGrow
	     sind Bedingungen fuer Pflanzen, und eine Fackel erfuellt keine davon von sich aus.
	     Dass 0 sie abschaltet, belegt Vanilla selbst: plantedMushroom1 ist ein vom Spieler
	     setzbarer PlantGrowing-Block mit genau dieser Kombination - Pilze, die in dunklen
	     Hoehlen wachsen.

	     WAS BEI NICHTERFUELLUNG PASSIERT, und darum steht es hier: UpdateTick ruft als
	     zweites CheckPlantAlive, und das setzt SetBlockRPC(pos, BlockValue::Air). Der
	     Block geht dann nicht aus - er VERSCHWINDET. Das ist der Grund fuer
	     Prueflistenpunkt 11 (D64): eine Wandfackel muss im GESCHLOSSENEN Raum abbrennen,
	     eine im Freien beweist nichts.

	     IsRandom="false", UND DAS IST ABSICHT. Die Streuung heisst GrowthDeviation (ein
	     RandomGaussian mal diesem Wert), und Vanilla setzt sie in ganz blocks.xml NULL
	     Mal - es gibt also keinen Wert, an dem man die Einheit ablesen koennte. Eine
	     geratene Streuung kann eine Fackel in Sekunden ausgehen oder Tage brennen lassen.
	     Erst die Brenndauer messen (WP6.6), dann streuen.

	     GrowIfAnythinOnTop wird ausdruecklich gesetzt, obwohl true die Vorgabe ist: der
	     Tippfehler ist in LateInit des Spiels, und wer 'GrowIfAnythingOnTop' schreibt,
	     schreibt einen Schluessel, den niemand liest, und merkt nichts.

	     WAS DER KLASSENWECHSEL KOSTET. wallTorchLightPlayer und candleWallLightPlayer
	     trugen Class="TorchHeatMap", also BlockTorchHeatMap : BlockTorch : BlockParticle.
	     Gemessen bleibt davon: das Licht (steckt im Prefab, nicht in der Klasse - beide
	     Bloecke benutzen BlockLight gar nicht und leuchten trotzdem), das Aufnehmen
	     (CanPickup steht als Block-Eigenschaft in wallTorchLight bzw. candleWallLight)
	     und die Flamme (kein ParticleName angemeldet, der Versatz war rechnerisch).
	     WEG IST EINES: AIDirector::NotifyActivity. Fackeln machen keine Hitze mehr auf
	     der Karte, ziehen also keine Schreier. Vom Nutzer so entschieden; vermerkt als
	     Prueflistenpunkt 12, weil D29 im selben Paket in dieselbe Richtung wirkt.

	     GrowthRate ist nach Vanillas eigenem Kommentar an cropsGrowingMaster eine Angabe
	     IN MINUTEN ("should be set no lower than 2"). Ob real oder ingame, sagt der
	     Spieltest; bei der Vorgabe von 60 Minuten je 24-Stunden-Zyklus (goDayNightLength:
	     "wie viele Minuten in der realen Welt vergehen, bis im Spiel 24 Stunden vergangen
	     sind") waeren 30 Minuten eine halbe Spielnacht. Dazu kommt, dass GetTickRate den
	     Wert mit einem spielweiten CropGrowthModifier multipliziert: wer die
	     Pflanzenwachstums-Einstellung des Servers dreht, dreht die Brenndauer mit. -->

	<!-- ==== Wandfackel: Vanilla hat beide Haelften des Kreislaufs schon gebaut ====
	     torchWallHolder ist der unbeleuchtete Halter (CreativeMode="None", steht in POIs)
	     und traegt schon einen UpgradeBlock zurueck auf wallTorchLightPlayer, zu bezahlen
	     mit einer meleeToolTorch. Er ist damit der fertige "ausgebrannt"-Zustand UND der
	     fertige Weg zum Wiederanzuenden. Wir setzen nur das Next darauf. -->
	<set xpath="/blocks/block[@name='wallTorchLightPlayer']/property[@name='Class']/@value">PlantGrowing</set>
	<append xpath="/blocks/block[@name='wallTorchLightPlayer']">
		<property class="PlantGrowing">
			<property name="Next" value="torchWallHolder" />
			<property name="GrowthRate" value="30" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>

	<!-- ==== Unschlittkerze: Wand und Tisch ====
	     candleTableLightPlayer erbt von candleWallLightPlayer, bekommt das Class also
	     geschenkt - aber NICHT den PlantGrowing-Block, denn der zeigt auf den falschen
	     Ausgebrannt-Zustand (Wandkerze statt Tischkerze). Darum ein eigener fuer den
	     Tisch; das 'Extends' ueberschreibt der eigene Eintrag. -->
	<set xpath="/blocks/block[@name='candleWallLightPlayer']/property[@name='Class']/@value">PlantGrowing</set>
	<append xpath="/blocks/block[@name='candleWallLightPlayer']">
		<property class="PlantGrowing">
			<property name="Next" value="blk700_kerzenstumpf_wand" />
			<property name="GrowthRate" value="15" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>
	<append xpath="/blocks/block[@name='candleTableLightPlayer']">
		<property class="PlantGrowing">
			<property name="Next" value="blk700_kerzenstumpf_tisch" />
			<property name="GrowthRate" value="15" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>

	<!-- ==== Oellampe ====
	     VIER Varianten (01 bis 04), alle vom Spieler setzbar, alle mit demselben
	     Ausgebrannt-Zustand: eine leere Lampe sieht aus wie eine leere Lampe. Das ist
	     der einzige Punkt, an dem vier Zeilen auf einen Block zeigen - gewollt, weil
	     sonst vier gleich aussehende Bloecke entstehen.

	     ACHTUNG, EIN SCHLUSS UND KEINE MESSUNG: diese Bloecke hatten bisher die LEERE
	     Klasse, und Vanillas Kommentar dazu lautet "Needs to have a blank class to allow
	     the light to turn on automatically when placed". PlantGrowing fasst Licht nicht
	     an (gemessen: BlockPlantGrowing ruft nichts an LightLOD), aber ob eine leere
	     Klasse und PlantGrowing hier gleich wirken, sagt erst das Spiel. WP6.6 muss eine
	     Oellampe UNMITTELBAR NACH DEM SETZEN ansehen. -->
	<!-- NUR AM 01 EIN <set>, AN 02 BIS 04 EIN <append> — berichtigt 2026-11-08 (WP7.1).
	     Hier standen vier <set> auf Class und vier auf DescriptionKey. Drei davon haben
	     NICHTS getroffen und das Spiel haette es nur ins Protokoll geschrieben:
	     lanternOld_02/03/04_Player fuehren beide Eigenschaften nicht selbst, sie ERBEN sie
	     per Extends von lanternOld_01_Player. Ein <set> auf einen Knoten, den es nicht gibt,
	     ist kein Fehler, sondern ein Nichts.
	     Aufgefallen beim ersten Lauf der neuen XPath-Pruefung in kette-pruefen.ps1, nicht
	     beim Lesen. Angehaengt statt vererbt, weil 'Extends wird nach dem Patchen
	     aufgeloest' eine Annahme ist und ein <append> keine braucht. -->
	<set xpath="/blocks/block[@name='lanternOld_01_Player']/property[@name='Class']/@value">PlantGrowing</set>
	<append xpath="/blocks/block[@name='lanternOld_01_Player']">
		<property class="PlantGrowing">
			<property name="Next" value="blk700_oellampe_leer" />
			<property name="GrowthRate" value="60" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>
	<append xpath="/blocks/block[@name='lanternOld_02_Player']">
		<property name="Class" value="PlantGrowing" />
		<property name="DescriptionKey" value="blk700_oellampeDesc" />
		<property class="PlantGrowing">
			<property name="Next" value="blk700_oellampe_leer" />
			<property name="GrowthRate" value="60" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>
	<append xpath="/blocks/block[@name='lanternOld_03_Player']">
		<property name="Class" value="PlantGrowing" />
		<property name="DescriptionKey" value="blk700_oellampeDesc" />
		<property class="PlantGrowing">
			<property name="Next" value="blk700_oellampe_leer" />
			<property name="GrowthRate" value="60" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>
	<append xpath="/blocks/block[@name='lanternOld_04_Player']">
		<property name="Class" value="PlantGrowing" />
		<property name="DescriptionKey" value="blk700_oellampeDesc" />
		<property class="PlantGrowing">
			<property name="Next" value="blk700_oellampe_leer" />
			<property name="GrowthRate" value="60" />
			<property name="FertileLevel" value="0" />
			<property name="LightLevelStay" value="0" />
			<property name="LightLevelGrow" value="0" />
			<property name="GrowIfAnythinOnTop" value="true" />
			<property name="IsRandom" value="false" />
		</property>
	</append>

	<!-- Die Oellampe wurde mit resourceElectricParts geflickt und traegt
	     TraderStageTemplate electricTier1. Beides ist gesperrt bzw. falsch: eine
	     Blechlampe flickt der Schmied. Der Abwurf bleibt Alteisen - eine zerbrochene
	     Lampe ist Blech. -->
	<set xpath="/blocks/block[@name='lanternOld_01_Player']/property[@class='RepairItems']/property[@name='resourceElectricParts']/@name">resourceForgedIron</set>
	<set xpath="/blocks/block[@name='lanternOld_01_Player']/property[@name='TraderStageTemplate']/@value">baseTier0</set>

	<!-- EIGENER BESCHREIBUNGSSCHLUESSEL, und das ist kein Luxus. Vanillas Oellampen zeigen
	     auf 'blockVariantHelperGroupDesc', und diesen Schluessel teilen GEMESSEN 50
	     Bloecke: Waffenschraenke, Fernseher, Garagentore, Stuehle, Blumentoepfe. Wer ihn
	     ueberschreibt, schreibt die Beschreibung der Oellampe auf alle fuenfzig. Genau
	     diese Falle steht oben schon beim Kalkofen und seinem 'CraftActionName'.
	     Darum zeigen unsere vier Lampen auf einen eigenen Schluessel. -->
	<!-- Nur das 01 traegt den Schluessel selbst; 02 bis 04 bekommen ihn oben per
	     <append> mitgeliefert (siehe die Berichtigung dort). -->
	<set xpath="/blocks/block[@name='lanternOld_01_Player']/property[@name='DescriptionKey']/@value">blk700_oellampeDesc</set>

	<append xpath="/blocks">

		<!-- ==== Kerzenstumpf, Wand und Tisch ====
		     Dasselbe Modell wie die brennende Kerze, nur ohne Klasse und ohne Licht: ein
		     Stumpf sieht aus wie eine Kerze, er leuchtet nur nicht. Wieder anzuzuenden
		     mit einer Kerze, nach dem Muster von Vanillas torchWallHolder (vier Schlaege,
		     ein Gegenstand). -->
		<block name="blk700_kerzenstumpf_wand">
			<property name="CreativeMode" value="None" />
			<property name="CustomIcon" value="candleWallLight" />
			<property name="DescriptionKey" value="blk700_kerzenstumpf_wandDesc" />
			<property name="Material" value="Mpaper" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Lighting/candle_wallPrefab.prefab" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="OnlySimpleRotations" value="true" />
			<property name="IsTerrainDecoration" value="true" />
			<property name="StabilitySupport" value="false" />
			<property name="MaxDamage" value="1" />
			<property class="UpgradeBlock">
				<property name="ToBlock" value="candleWallLightPlayer" />
				<property name="Item" value="candle" />
				<property name="ItemCount" value="1" />
				<property name="UpgradeHitCount" value="4" />
			</property>
			<drop event="Destroy" count="0" />
			<property name="SortOrder1" value="B202" />
			<property name="SortOrder2" value="3204" />
			<property name="FilterTags" value="MC_building,SC_lighting" />
		</block>

		<block name="blk700_kerzenstumpf_tisch">
			<property name="Extends" value="blk700_kerzenstumpf_wand" param1="CustomIcon,DescriptionKey,Model,Place,SortOrder2" />
			<property name="CustomIcon" value="candleTableLight" />
			<property name="DescriptionKey" value="blk700_kerzenstumpf_tischDesc" />
			<property name="Model" value="@:Entities/Lighting/candle_tablePrefab.prefab" />
			<property name="Place" value="TowardsPlacer90" />
			<property name="SortOrder2" value="3205" />
			<property class="UpgradeBlock">
				<property name="ToBlock" value="candleTableLightPlayer" />
				<property name="Item" value="candle" />
				<property name="ItemCount" value="1" />
				<property name="UpgradeHitCount" value="4" />
			</property>
		</block>

		<!-- ==== Oellampe, leer ====
		     Nachgefuellt wird mit Tierfett, nicht mit einer neuen Lampe: das Blech ist
		     ganz, das Oel ist aus. Darum zwei Fett und nicht die fuenf des Bau-Rezepts. -->
		<block name="blk700_oellampe_leer">
			<property name="CreativeMode" value="None" />
			<property name="CustomIcon" value="lanternOld_01" />
			<property name="DescriptionKey" value="blk700_oellampe_leerDesc" />
			<property name="Material" value="Mmetal_thin" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Lighting/lanternOld_01Prefab.prefab" />
			<property name="ImposterDontBlock" value="true" />
			<property name="WaterFlow" value="permitted" />
			<property name="Collide" value="movement,melee,bullet,arrow,rocket" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="StabilitySupport" value="false" />
			<property name="MaxDamage" value="50" />
			<property class="UpgradeBlock">
				<property name="ToBlock" value="lanternOld_01_Player" />
				<property name="Item" value="resourceAnimalFat" />
				<property name="ItemCount" value="2" />
				<property name="UpgradeHitCount" value="4" />
			</property>
			<property class="RepairItems">
				<property name="resourceForgedIron" value="2" />
			</property>
			<drop event="Destroy" name="resourceScrapIron" count="5" />
			<property name="SortOrder1" value="B202" />
			<property name="SortOrder2" value="1261" />
			<property name="FilterTags" value="MC_building,SC_lighting" />
		</block>

		<!-- ==== Holzfeuer, brennend und erloschen ====
		     ABWEICHUNG VON F-08, und sie ist benannt: F-08 nennt einen "Feuerkorb", also
		     einen Korb auf einem Gestell. So ein Modell hat Vanilla nicht. Was es hat,
		     ist ein Glutbett aus verbrannten Scheiten - mit Licht
		     (pileEmberBurntLogs1LightPrefab) und ohne (…1NoEmissivePrefab), also beide
		     Haelften aus derselben Modellfamilie. Darum heisst es Holzfeuer und nicht
		     Feuerkorb: der Name folgt dem, was man sieht. Die Funktion, die F-08 will -
		     ein helles Feuer im Freien, das laenger haelt als eine Fackel - steht damit;
		     der Korb braucht ein eigenes Asset und gehoert zu F-16 in Phase 2.

		     Vorbild ist Vanillas emberPileLightPOI1: dasselbe Modell, dieselbe Glut,
		     dieselbe buffBurningEnvironment fuer den, der hineintritt, und derselbe
		     Kohle-Abbau. Was wir ergaenzen: der Spieler darf es bauen, und es geht aus. -->
		<block name="blk700_holzfeuer">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="PlantGrowing" />
			<property class="PlantGrowing">
				<property name="Next" value="blk700_holzfeuer_aus" />
				<property name="GrowthRate" value="45" />
				<property name="FertileLevel" value="0" />
				<property name="LightLevelStay" value="0" />
				<property name="LightLevelGrow" value="0" />
				<property name="GrowIfAnythinOnTop" value="true" />
				<property name="IsRandom" value="false" />
			</property>
			<property name="Light" value="0.5" />
			<property name="CustomIcon" value="emberPileDeco1" />
			<property name="DescriptionKey" value="blk700_holzfeuerDesc" />
			<property name="Material" value="Mwood_weak" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Lighting/pileEmberBurntLogs1LightPrefab.prefab" />
			<property name="ModelOffset" value="0,0,0" />
			<property name="WaterFlow" value="permitted" />
			<property name="Collide" value="melee,bullet,arrow,rocket" />
			<property name="Place" value="TowardsPlacer90" />
			<property name="IsTerrainDecoration" value="true" />
			<property name="StabilitySupport" value="false" />
			<property name="MaxDamage" value="50" />
			<property name="BuffsWhenWalkedOn" value="buffBurningEnvironment" />
			<property name="ActiveRadiusEffects" value="buffCampfireAOE,3" />
			<property name="EconomicValue" value="10" />
			<property name="SellableToTrader" value="false" />
			<property class="RepairItems">
				<property name="resourceWood" value="5" />
			</property>
			<drop event="Harvest" name="resourceCoal" count="3,6" tag="oreWoodHarvest" />
			<drop event="Harvest" name="resourceCoal" count="3,6" tag="coalHarvest" />
			<drop event="Destroy" name="resourceWood" count="1" />
			<property name="SortOrder1" value="B202" />
			<property name="SortOrder2" value="3300" />
			<property name="Group" value="Basics,Limited,Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_lighting" />
			<property name="SoundPickup" value="campfire_grab" />
			<property name="SoundPlace" value="campfire_place" />
		</block>

		<block name="blk700_holzfeuer_aus">
			<property name="Extends" value="blk700_holzfeuer" param1="Class,Light,DescriptionKey,Model,CreativeMode,BuffsWhenWalkedOn,ActiveRadiusEffects,SortOrder2" />
			<property name="CreativeMode" value="None" />
			<property name="Class" value="" />
			<property name="DescriptionKey" value="blk700_holzfeuer_ausDesc" />
			<property name="Model" value="@:Entities/Debris/pileEmberBurntLogs1NoEmissivePrefab.prefab" />
			<property name="SortOrder2" value="3301" />
			<property class="UpgradeBlock">
				<property name="ToBlock" value="blk700_holzfeuer" />
				<property name="Item" value="resourceWood" />
				<property name="ItemCount" value="10" />
				<property name="UpgradeHitCount" value="4" />
			</property>
		</block>

	</append>

	<!-- ================================================================================
	     F-18 / F-08 WEHRBAUTEN, Plan-0001 WP6.2

	     SIEBEN WAREN GEFORDERT. Was davon mit XML zu machen ist, und was nicht:

	       Spitzpfaehle      trapSpikesWoodDmg0   steht in Vanilla fertig, nur Sprache
	       Eisenspitzen      trapSpikesIronDmg0   dito
	       Palisade          logWall* (8 Bloecke) Dev-Requisite, wird baubar gemacht
	       Torhaus-Tor       doorWoodLargeGate    steht, hatte aber kein Rezept
	       Graben            -                    kein Block: der Spieler GRAEBT
	       Wehrgang          -                    kein Block: aus Vanilla-Formen gebaut
	       Schwingbalken     -                    aufgeschoben, Begruendung unten
	       Pechtopf          -                    aufgeschoben, Begruendung unten

	     DIE SPIESSE BRAUCHEN KEINE ZEILE HIER. trapSpikesWoodMaster traegt schon
	     Damage 33, Damage_received 33, MaxDamage 100, Reparatur mit Holz und ein Rezept
	     aus 20 Holz; die Eisenstufe kostet 4 Schmiedeeisen als Aufwertung und haelt 200.
	     Beides ist fuer 700 richtig, wie es ist - gespitzte Pfaehle und eiserne Spitzen
	     sind keine Erfindung der Neuzeit. Umgedeutet wird nur die Sprache.

	     PALISADE: acht Bloecke, die Vanilla schon modelliert hat und nie freigegeben hat.
	     Sie liegen unter Entities/BanditProps, tragen CreativeMode="Dev" und haben kein
	     Rezept - Requisiten fuer Banditenlager. Material Mwood (MaxDamage 200), also
	     zwischen Spiess (100) und gebauter Holzwand (500); eine Palisade ist rauer als
	     eine Wand und haelt weniger. Ein Abschnitt ist 3 breit und 4 hoch
	     (MultiBlockDim 3,4,1), die gespitzten sind 3x5.

	     DIE GESPITZTEN TUN JETZT WIRKLICH WEH, und das ist der einzige Eingriff ins
	     Verhalten. Vanillas logWallLeftSpikes hat Spitzen am Modell und keinen Schaden -
	     sie sehen gefaehrlich aus und sind es nicht. Gemessen: 'Damage' wird von der
	     Klasse BlockDamage gelesen (Init bricht mit einer Fehlerzeile ab, wenn sie fehlt),
	     und BlockTrunkTip - die Klasse der Spiesse - ERBT von BlockDamage; sie legt nur
	     RotateVerticesOnCollisionCheck darauf. Wir nehmen darum 'Damage' und nicht
	     'TrunkTip': die Drehbehandlung ist fuer Baumstumpf-Modelle, unsere Palisade ist
	     eine ModelEntity. 15 Schaden statt der 33 eines Spiesses - eine Mauer ist keine
	     Falle -, und Damage_received 15, damit sie sich am Angreifer auch abnutzt.

	     NICHT GEMACHT, UND WARUM:

	       GRABEN. Ein Graben ist abgetragenes Gelaende, kein Block. Der Spieler hebt ihn
	       mit der Schaufel aus; es gibt nichts zu bauen. F-18 nennt ihn unter
	       "Verteidigungsbauten", er gehoert aber zur Bauweise, nicht zum Bausatz.

	       WEHRGANG. Dasselbe: ein Wehrgang ist eine Platte mit Bruestung oben auf der
	       Mauer, gebaut aus den Vanilla-Formen, die WP6.1 schon umgedeutet hat
	       (*Plate, *CNRFull, Gelaender). P5 sagt ausdruecklich, dass die Formen bleiben.

	       SCHWINGBALKEN-FALLE. Ein pendelnder Balken braucht bewegte Physik und einen
	       Ausloeser. Vanillas einzige mechanische Fallen-Klasse ist BladeTrap, und die
	       haengt am Strom (gesperrt). Von den 50 Blockklassen in V 3.40 hat keine ein
	       Pendel. Das waere C# - und Phase 1 steht ausdruecklich ohne Harmony-Patch.
	       Vermerkt fuer F-15 in WP7, wo die Runenfallen ohnehin Fallenverhalten brauchen.

	       PECHTOPF. Auch das braucht einen Ausloeser: ein Topf, den man kippt. Was XML
	       gibt, ist ein BRENNENDER PLATZ - und den liefert WP6.4 schon als
	       blk700_holzfeuer: BuffsWhenWalkedOn="buffBurningEnvironment", wer hineintritt,
	       verbrennt. Einen zweiten Block mit derselben Wirkung und einem anderen Namen
	       zu bauen, waere Verdopplung ohne Gewinn. Vermerkt fuer F-15 in WP7. -->

	<!-- Palisade sichtbar und baubar machen. Group und DescriptionKey stehen nur an
	     logWallLeft - die anderen sieben erben beide ueber 'Extends'. CreativeMode steht
	     an jedem einzeln und muss darum achtmal gesetzt werden. -->
	<append xpath="/blocks/block[@name='logWallLeft']">
		<property name="Group" value="Building,advBuilding" />
		<property name="DescriptionKey" value="blk700_palisadeDesc" />
	</append>
	<set xpath="/blocks/block[@name='logWallLeft']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallRight']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallLeft2']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallRight2']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallLeftSpikes']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallRightSpikes']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallPillar']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='logWallPillarCap']/property[@name='CreativeMode']/@value">Player</set>

	<!-- Die gespitzten Abschnitte bekommen Schaden. Eigener DescriptionKey, weil ein
	     Spieler wissen soll, dass DIESE Variante wehtut und die glatte nicht. -->
	<append xpath="/blocks/block[@name='logWallLeftSpikes']">
		<property name="Class" value="Damage" />
		<property name="Damage" value="15" />
		<property name="Damage_received" value="15" />
		<property name="DescriptionKey" value="blk700_palisade_spitzenDesc" />
	</append>
	<append xpath="/blocks/block[@name='logWallRightSpikes']">
		<property name="Class" value="Damage" />
		<property name="Damage" value="15" />
		<property name="Damage_received" value="15" />
		<property name="DescriptionKey" value="blk700_palisade_spitzenDesc" />
	</append>

	<!-- Das grosse Holztor steht in Vanilla, hat aber kein Rezept (nur das Rezept fehlt,
	     der Block ist vollstaendig: CompositeTileEntity, 5x5x1, MaxDamage 250, Reparatur
	     mit 50 Holz). Eigener DescriptionKey, weil Vanillas 'doorGroupDesc' GEMESSEN von
	     55 Bloecken geteilt wird - dieselbe Falle wie bei den Oellampen. -->
	<set xpath="/blocks/block[@name='doorWoodLargeGate']/property[@name='DescriptionKey']/@value">blk700_torhausDesc</set>

	<!-- Die Spiesse: kein Verhalten zu aendern, nur die Sprache. Der Vollstaendigkeit
	     halber hier vermerkt, damit niemand sie in dieser Datei sucht - sie stehen in
	     mod/700_90_Sprache/Config/Localization.csv. -->
</config>
