<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_40_Bauen / recipes.xml
	     F-04 Werkstaetten, Plan-0001 WP4.3 (Berichtigung) und WP5.5b

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     ===================================================================
	     VIER VON FUENF WERKSTAETTEN WAREN NICHT ZU BAUEN
	     ===================================================================

	     Das ist eine BERICHTIGUNG AN WP4.3, gefunden beim Bauen des Webstuhls, und sie
	     ist die vierte ihrer Art in WP5. WP4.3 hat die fuenf Vanilla-Werkstaetten
	     umgedeutet - Namen, Brennstoff, Werkzeugslots - und dabei nie nachgesehen, ob
	     ihr BAU-REZEPT nach dem Purge noch geht. Gemessen gegen die 590 gesperrten
	     Kennungen:

	       campfire          Feuerstelle       1 Zutat, alle erlaubt           GEHT
	       workbench         Zimmermannsbank   resourceMechanicalParts,
	                                           resourceDuctTape               TOT
	       forge             Rennofen + Esse   resourceDuctTape,
	                                           resourceMetalPipe              TOT
	       chemistryStation  Kraeuterkueche    toolBeaker, resourceMetalPipe,
	                                           resourceAcid                   TOT
	       cementMixer       Kalkofen          resourceSpring, smallEngine,
	                                           resourceMechanicalParts        TOT

	     DAS IST KEINE KLEINIGKEIT, SONDERN DER TRAGENDE TEIL DER KETTE. Ohne Esse kein
	     Schmiedeeisen; ohne Schmiedeeisen keine Klinge, keine Spatha, kein Kettenhemd.
	     Die ganze Rohstoffkette aus WP4.6 stand auf einem Block, den niemand bauen
	     kann, und F-04s Kriterium "jede Werkstatt hat ein Bau-Rezept" war auf dem
	     Papier abgehakt. Gefunden hat es die Zaehlung 'rezepte_mit_gesperrter_zutat'
	     aus WP5.1 - die 94 toten Rezepte, von denen hier vier stehen.

	     WARUM ES KEINE NEUE ENTSCHEIDUNG BRAUCHT: die Zutaten kommen aus F-04s eigener
	     Werkstatt-Tabelle (Lehm, Stein, Holz, Leder, Schmiedeeisen), und derselbe Griff
	     - gesperrte Zutat heraus, zeitgemaesse hinein - ist in WP5.1 fuer elf Waffen
	     schon gemacht. Geaendert wird so wenig wie moeglich: die gesperrten Zutaten
	     fallen, eine zeitgemaesse kommt dazu, der Rest der Vanilla-Zeile bleibt stehen
	     samt ihren tags. Die Rezepte bleiben 'learnable' und haengen damit an der
	     Stufe Werkstattbau (craftingWorkstations): Esse ab Level 4, Zimmermannsbank
	     ab 10. Gemessen in WP7.5 (D70) - und die Stufe steigt nur durch ihr Lehrblatt.
	-->

	<!-- Zimmermannsbank: Holz, Naegel, Schmiedeeisen - und Leder statt Klebeband und
	     Maschinenteilen. Riemen und Lederscharniere sind das, was eine Bank aus dem
	     8. Jahrhundert zusammenhaelt. -->
	<remove xpath="/recipes/recipe[@name='workbench']/ingredient[@name='resourceMechanicalParts']" />
	<remove xpath="/recipes/recipe[@name='workbench']/ingredient[@name='resourceDuctTape']" />
	<append xpath="/recipes/recipe[@name='workbench']">
		<ingredient name="resourceLeather" count="10" />
	</append>

	<!-- Rennofen und Esse: Bruchstein, ein Pfosten, Leder (Blasebalg) - und Lehm statt
	     Klebeband und Metallrohr. Ein Rennofen IST Lehm; ohne ihn haelt die Ofenwand
	     die Hitze nicht. -->
	<remove xpath="/recipes/recipe[@name='forge']/ingredient[@name='resourceDuctTape']" />
	<remove xpath="/recipes/recipe[@name='forge']/ingredient[@name='resourceMetalPipe']" />
	<append xpath="/recipes/recipe[@name='forge']">
		<ingredient name="resourceClayLump" count="50" />
	</append>

	<!-- Kraeuterkueche: drei gesperrte Zutaten fallen (Becherglas, Metallrohr, Saeure),
	     Toepfe bleiben, Lehm kommt dazu. Das Schmiedeeisen sinkt von 100 auf 20 - 100
	     Barren fuer eine Kraeuterkueche waren Vanillas Preis fuer eine Chemieanlage mit
	     Destillationssaeule, und F-04 nennt hier Moerser und Destillierhelm. Die
	     Mengenaenderung ist Balancing und steht darum auch in der Tabelle von WP5.6. -->
	<remove xpath="/recipes/recipe[@name='chemistryStation']/ingredient[@name='toolBeaker']" />
	<remove xpath="/recipes/recipe[@name='chemistryStation']/ingredient[@name='resourceMetalPipe']" />
	<remove xpath="/recipes/recipe[@name='chemistryStation']/ingredient[@name='resourceAcid']" />
	<set xpath="/recipes/recipe[@name='chemistryStation']/ingredient[@name='resourceForgedIron']/@count">20</set>
	<append xpath="/recipes/recipe[@name='chemistryStation']">
		<ingredient name="resourceClayLump" count="40" />
	</append>

	<!-- Kalkofen: Feder, Kleinmotor und Maschinenteile fallen - ein Ofen hat keinen
	     Motor. Was bleibt, ist Schmiedeeisen fuer die Beschlaege, dazu Bruchstein und
	     Lehm fuer den Schacht. -->
	<remove xpath="/recipes/recipe[@name='cementMixer']/ingredient[@name='resourceSpring']" />
	<remove xpath="/recipes/recipe[@name='cementMixer']/ingredient[@name='smallEngine']" />
	<remove xpath="/recipes/recipe[@name='cementMixer']/ingredient[@name='resourceMechanicalParts']" />
	<append xpath="/recipes/recipe[@name='cementMixer']">
		<ingredient name="resourceCobblestones" count="50" />
		<ingredient name="resourceClayLump" count="50" />
	</append>

	<!-- ===================================================================
	     DAS BAU-REZEPT DES WEBSTUHLS (WP5.5b)
	     ===================================================================

	     An der Zimmermannsbank, nicht von Hand: ein Trittwebstuhl ist Zimmermannsarbeit,
	     und damit entsteht die Treppe Zimmermannsbank -> Webstuhl -> Gambeson. Holz und
	     Faden tragen das Geraet, Leder haelt die Schaefte.

	     Ohne 'tags' in dieser Datei. Seit WP7.5 (D70) ist der Webstuhl trotzdem
	     gebunden: 700_50_Fortschritt/Config/recipes.xml setzt ihm die Marken, und die
	     Stufe Werkstattbau schaltet ihn ab Level 14 frei - auf dem ersten Platz, den
	     der Purge nach der Werkbank freigemacht hat. Holzfeuer, Palisade und Tor
	     bleiben offen: Vanilla bindet keine Bauteile, und eine Stufe fuers Bauen gibt
	     es nicht.
	-->
	<append xpath="/recipes">

		<recipe name="blk700_webstuhl" count="1" craft_area="workbench" craft_time="60" is_trackable="false">
			<ingredient name="resourceWood" count="60" />
			<ingredient name="resourceYuccaFibers" count="30" />
			<ingredient name="resourceLeather" count="5" />
			<ingredient name="resourceNail" count="10" />
		</recipe>

		<!-- Holzfeuer (F-08, WP6.4): Scheite und ein paar Steine als Einfassung. Teuer
		     genug, dass man es nicht ueberall hinstellt, billig genug fuer eine Nacht im
		     Freien. Ohne Werkstatt - ein Feuer schichtet man mit den Haenden. -->
		<recipe name="blk700_holzfeuer" count="1" craft_time="20" is_trackable="false">
			<ingredient name="resourceWood" count="20" />
			<ingredient name="resourceRockSmall" count="5" />
		</recipe>

	</append>

	<!-- ================================================================================
	     F-08 LICHT, Plan-0001 WP6.4

	     DIE OELLAMPE WAR NICHT BAUBAR. Vanillas Rezept fuer lanternOldBlockVariantHelper
	     verlangt 5 resourceOil, und resourceOil ist gesperrt (Mineraloel). Gefunden mit
	     demselben Zaehler, der die vier unbaubaren Werkstaetten gefunden hat:
	     rezepte_mit_gesperrter_zutat.

	     Das Oel einer Blechlampe um 700 ist Tierfett oder Pflanzenoel, und Tierfett gibt
	     es als resourceAnimalFat. Die Menge bleibt 5 - die Lampe fassen, nicht
	     verbilligen. Die uebrigen drei Zutaten (Schmiedeeisen, Naegel, Tuch) stehen alle
	     und passen zu einer genieteten Blechlampe mit Docht. -->
	<remove xpath="/recipes/recipe[@name='lanternOldBlockVariantHelper']/ingredient[@name='resourceOil']" />
	<append xpath="/recipes/recipe[@name='lanternOldBlockVariantHelper']">
		<ingredient name="resourceAnimalFat" count="5" />
	</append>

	<!-- ================================================================================
	     F-18 WEHRBAUTEN, Plan-0001 WP6.2

	     Acht Palisaden-Abschnitte und ein Tor, die Vanilla modelliert und nie freigegeben
	     hat. Die Preise folgen der Groesse: ein Abschnitt ist MultiBlockDim 3,4,1, also
	     zwoelf Zellen; die gespitzten sind 3,5,1, also fuenfzehn. Zum Vergleich kostet
	     eine gebaute Holzwand ueber den Ausbaupfad 8 Holz JE ZELLE - eine Palisade ist
	     also deutlich billiger als 96 Holz und haelt dafuer 200 statt 500.

	     Ohne Werkstatt: Stammholz spaltet und setzt man mit Axt und Haenden. -->
	<append xpath="/recipes">

		<recipe name="logWallLeft" count="1" craft_time="30" is_trackable="false">
			<ingredient name="resourceWood" count="50" />
		</recipe>
		<recipe name="logWallRight" count="1" craft_time="30" is_trackable="false">
			<ingredient name="resourceWood" count="50" />
		</recipe>
		<recipe name="logWallLeft2" count="1" craft_time="30" is_trackable="false">
			<ingredient name="resourceWood" count="50" />
		</recipe>
		<recipe name="logWallRight2" count="1" craft_time="30" is_trackable="false">
			<ingredient name="resourceWood" count="50" />
		</recipe>

		<!-- Gespitzt: drei Zellen mehr Holz und das Zuspitzen. -->
		<recipe name="logWallLeftSpikes" count="1" craft_time="40" is_trackable="false">
			<ingredient name="resourceWood" count="65" />
		</recipe>
		<recipe name="logWallRightSpikes" count="1" craft_time="40" is_trackable="false">
			<ingredient name="resourceWood" count="65" />
		</recipe>

		<recipe name="logWallPillar" count="1" craft_time="15" is_trackable="false">
			<ingredient name="resourceWood" count="20" />
		</recipe>
		<recipe name="logWallPillarCap" count="1" craft_time="10" is_trackable="false">
			<ingredient name="resourceWood" count="10" />
		</recipe>

		<!-- Das Torhaus-Tor: fuenf mal fuenf, und das Einzige an den Wehrbauten, das
		     Eisen braucht - Baender und Angeln. An der Zimmermannsbank, weil ein Tor
		     gezimmert und nicht gestapelt wird. -->
		<recipe name="doorWoodLargeGate" count="1" craft_area="workbench" craft_time="90" is_trackable="false">
			<ingredient name="resourceWood" count="100" />
			<ingredient name="resourceNail" count="20" />
			<ingredient name="resourceForgedIron" count="10" />
		</recipe>

	</append>

	<!-- ===================================================================
	     SACKGASSEN: 8 VANILLA-REZEPTE BEKOMMEN ZEITGEMAESSE ZUTATEN, 1 FAELLT
	     ===================================================================
	     Balancing 0003 (docs/balancing/0003-sackgassen-und-belohnungen.md), vom
	     Nutzer am 22. November 2026 abgenommen (D89). Tabellen 1 und 4.

	     Gemessen am ConfigsDump vom 21. November: 80 Rezepte ueberleben den Purge
	     und nennen eine gesperrte Zutat. Hier stehen die 9 zu Feld, Stall, Imkerei
	     und Wehrbau; 59 stehen in 700_30_Ausruestung, 12 in 700_20_Material.

	     Derselbe Griff wie oben bei den Werkstaetten: die gesperrte Zutat faellt,
	     eine zeitgemaesse kommt dazu oder geht in einer vorhandenen auf, der Rest
	     der Vanilla-Zeile bleibt samt ihren tags. Alle Mengen sind Setzungen fuer
	     WP9. -->

	<!-- Feld. Vanilla: Holz 4, verdorbenes Fleisch 10, SALPETER 25, Lehm 100. Gemahlene
	     Knochen duengen. Die neue Zutat steht VOR <effect_group>, und die
	     Qualitaetszeile (sie senkt die Mengen mit 'Vom Landleben') nennt den Knochen
	     statt des Salpeters. -->
	<remove xpath="/recipes/recipe[@name='farmPlotBlockVariantHelper']/ingredient[@name='resourcePotassiumNitratePowder']" />
	<insertAfter xpath="/recipes/recipe[@name='farmPlotBlockVariantHelper']/ingredient[@name='foodRottingFlesh']">
		<ingredient name="resourceBone" count="5" />
	</insertAfter>
	<set xpath="/recipes/recipe[@name='farmPlotBlockVariantHelper']/effect_group/passive_effect[@operation='perc_add']/@tags">foodRottingFlesh,resourceBone,resourceClayLump</set>

	<!-- Bienenstock. Vanilla: Wachs 5, Holz 100, Naegel 50, Schmiedeeisen 10,
	     KLEBEBAND 8. -->
	<remove xpath="/recipes/recipe[@name='cntApiary']/ingredient[@name='resourceDuctTape']" />
	<append xpath="/recipes/recipe[@name='cntApiary']">
		<ingredient name="resourceLeather" count="8" />
	</append>

	<!-- Brutkasten. Vanilla: Holz 200, KUNSTSTOFF 100, Naegel 50, Leim 5. Ein
	     Bienenkorb ist geflochten: Nesselfaser. -->
	<remove xpath="/recipes/recipe[@name='toolApiaryBroodBox']/ingredient[@name='resourceScrapPolymers']" />
	<append xpath="/recipes/recipe[@name='toolApiaryBroodBox']">
		<ingredient name="resourceYuccaFibers" count="50" />
	</append>

	<!-- Honigschleuder. Vanilla: Schmiedeeisen 20, Holz 100, MECHANIK 5, Naegel 5,
	     ROHR 2. Beides geht im Schmiedeeisen auf (20 + 5 + 2 = 27). -->
	<set xpath="/recipes/recipe[@name='toolApiaryExtractor']/ingredient[@name='resourceForgedIron']/@count">27</set>
	<remove xpath="/recipes/recipe[@name='toolApiaryExtractor']/ingredient[@name='resourceMechanicalParts']" />
	<remove xpath="/recipes/recipe[@name='toolApiaryExtractor']/ingredient[@name='resourceMetalPipe']" />

	<!-- Imkerpfeife. Vanilla: Tiegelstahl 10, Leder 20, Holz 20, Naegel 5, ROHR 2. Der
	     Rauchtopf ist aus Lehm. -->
	<remove xpath="/recipes/recipe[@name='toolApiarySmoker']/ingredient[@name='resourceMetalPipe']" />
	<append xpath="/recipes/recipe[@name='toolApiarySmoker']">
		<ingredient name="resourceClayLump" count="10" />
	</append>

	<!-- Huehnerstall. Vanilla: KUNSTSTOFF 200, Holz 100, Naegel 50, Schmiedeeisen 10,
	     KLEBEBAND 8. Der Kunststoff geht im Holz auf (100 + 200 = 300). -->
	<set xpath="/recipes/recipe[@name='cntChickenCoop']/ingredient[@name='resourceWood']/@count">300</set>
	<remove xpath="/recipes/recipe[@name='cntChickenCoop']/ingredient[@name='resourceScrapPolymers']" />
	<remove xpath="/recipes/recipe[@name='cntChickenCoop']/ingredient[@name='resourceDuctTape']" />
	<append xpath="/recipes/recipe[@name='cntChickenCoop']">
		<ingredient name="resourceLeather" count="8" />
	</append>

	<!-- Huehnerauslauf. Vanilla: Tiegelstahl 10, Holz 20, Naegel 50, ROHR 20. Ein
	     Auslauf ist ein Zaun (20 + 20 = 40 Holz). -->
	<set xpath="/recipes/recipe[@name='toolChickenCoopRun']/ingredient[@name='resourceWood']/@count">40</set>
	<remove xpath="/recipes/recipe[@name='toolChickenCoopRun']/ingredient[@name='resourceMetalPipe']" />

	<!-- Zugbruecke. Vanilla: Schmiedeeisen 20, Holz 20, FEDER 20, MECHANIK 20. Ketten
	     und Beschlaege sind Schmiedeeisen (20 + 20 + 20 = 60). -->
	<set xpath="/recipes/recipe[@name='metalReinforcedWoodDrawBridge']/ingredient[@name='resourceForgedIron']/@count">60</set>
	<remove xpath="/recipes/recipe[@name='metalReinforcedWoodDrawBridge']/ingredient[@name='resourceSpring']" />
	<remove xpath="/recipes/recipe[@name='metalReinforcedWoodDrawBridge']/ingredient[@name='resourceMechanicalParts']" />

	<!-- Das Bild FAELLT. Es verlangt Farbe (resourcePaint, gesperrt). Ein Rezept ist
	     ein Weg, kein Gegenstand (Vertrag 03 Abschnitt 4). -->
	<remove xpath="/recipes/recipe[@name='pictureVariantHelper']" />

</config>
