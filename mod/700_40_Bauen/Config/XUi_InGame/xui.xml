<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_40_Bauen / XUi_InGame/xui.xml
	     F-04 Werkstaetten, Plan-0001 WP4.5

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     Jede Werkstatt in 7DTD hat eine eigene Fenstergruppe 'workstation_<Blockname>'
	     in dieser Datei. Welche Fenster darin stehen, entscheidet, was der Spieler sieht;
	     'Modules' in blocks.xml entscheidet, was der Block fuehrt. BEIDE muessen
	     zusammenpassen - ein Modul ohne Fenster ist eine Kammer, die niemand oeffnen
	     kann, und ein Fenster ohne Modul ist ein leerer Rahmen.

	     Die Datei ist patchbar: sie steht in StockFileHashes und der Ordner heisst
	     XUi_InGame (mit Unterstrich), nicht XUi - siehe Vertrag 03 Abschnitt 3. -->

	<!-- Der Kalkofen bekommt seine Brennstoffkammer auch im Bild. Eingehaengt VOR
	     windowOutput, in derselben Reihenfolge, in der die Feuerstelle ihre Fenster
	     fuehrt (Liste, Infotafel, Warteschlange, Werkzeuge, Brennstoff, Ausgabe,
	     Kopfzeile) - sonst sitzt die Kammer hinter der Ausgabe und liest sich falsch. -->
	<insertBefore xpath="/xui/window_group[@name='workstation_cementMixer']/window[@name='windowOutput']">
		<window name="windowFuel" />
	</insertBefore>

	<!-- WP5.5b: die Fenstergruppe des Webstuhls. Das Spiel sucht sie unter
	     'workstation_<Blockname>'; der Block heisst blk700_webstuhl (blocks.xml).

	     Die fuenf Fenster und ihre Reihenfolge sind von workstation_workbench
	     abgeschrieben, samt der drei Attribute am window_group - eine Werkstatt ohne
	     'open_backpack_on_open' zeigt dem Spieler seinen Beutel nicht und ist damit
	     unbenutzbar. Kein windowFuel: der Webstuhl brennt nicht. Kein Werkzeugfenster:
	     siehe den Vermerk in blocks.xml. -->
	<append xpath="/xui">
		<window_group name="workstation_blk700_webstuhl" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true" defaultselected="bp.content">
			<window name="windowCraftingList" />
			<window name="craftingInfoPanel" />
			<window name="windowCraftingQueue" />
			<window name="windowOutput" />
			<window name="windowNonPagingHeader" />
		</window_group>
	</append>
</config>
