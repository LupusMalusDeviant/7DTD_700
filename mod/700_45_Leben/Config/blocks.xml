<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_45_Leben / blocks.xml - die Eichenrinde (F-11 §4, D197; zu pruefen N-141)
	     Vanilla hat keine Weide. Eichenrinde war bis zur Chinarinde das Fiebermittel des
	     Volkes ("Fieberrinde"), darum faellt sie hier: beim Faellen jeder Eiche mit einer
	     Chance von 25 %, ein bis zwei Stueck. Die gepflanzten Eichen tragen ihre eigenen
	     Abwurfzeilen (treeMasterGrowing), darum stehen sie einzeln da; treePlantedOak41m erbt
	     von treeOakLrg01. Ob die Chance je Baum oder je Schlag gilt, zeigt S-52. -->
	<append xpath="/blocks/block[@name='treeOakSml01']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>
	<append xpath="/blocks/block[@name='treeOakMed01']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>
	<append xpath="/blocks/block[@name='treeOakMed02']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>
	<append xpath="/blocks/block[@name='treeOakLrg01']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>
	<append xpath="/blocks/block[@name='treePlantedOak08m']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>
	<append xpath="/blocks/block[@name='treePlantedOak16m']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>
	<append xpath="/blocks/block[@name='treePlantedOak27m']"><drop event="Harvest" name="itm700_eichenrinde" count="1,2" prob=".25" tag="oreWoodHarvest" /></append>

	<!-- WILDKORN (F-19 "Ausarbeitung Phase 2" §2, Plan-0002 WP13.4, D202; zu pruefen N-143)
	     Gesaetes Getreide braucht ein Feldmodell (Unity). Bis dahin liest man die Koerner
	     wilder Graeser: wer Gras erntet, bekommt neben der Nesselfaser mit 10 % ein Wildkorn.
	     Neun Bloecke erben von treeGrassMaster: die Grasarten (treeShortGrass,
	     treeTallGrassDiagonal, treeSnowyGrassDiagonal ...), aber auch der Wuestenstrauch
	     (treeDesertShrub), die Waldblume (forestFlower) und die Schneebeeren-Straeucher
	     (plantedSnowberry3Harvest, ...HarvestPlayer). Die Grasarten, Strauch und Blume tragen
	     keine eigenen Abwurfzeilen und erben diese - auch Strauch und Blume geben also
	     Wildkorn [verifizieren S-54]. Die Schneebeeren-Straeucher haben eine eigene
	     Harvest-Zeile; ob sie die geerbte ersetzt, ist offen [verifizieren S-54]. Das gesaete
	     Gras (plantedtreeGrassSeed1) erbt nicht (kein Extends) und bleibt ohne Korn. -->
	<append xpath="/blocks/block[@name='treeGrassMaster']"><drop event="Harvest" name="itm700_wildkorn" count="1" prob=".1" tag="allHarvest" /></append>
</config>
