<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_45_Leben / recipes.xml - F-11 Heilkunde (Plan-0002 WP13.3, D197; zu pruefen N-141)
	     Sud und Theriak am Kochtopf ueber dem Feuer, wie Vanillas Kraeutersud und Goldrutentee;
	     die Salbe aus der Hand, wie Vanillas Aloe-Salbe. Der Theriak ist gebunden (tags in
	     700_50_Fortschritt/recipes.xml, Freischaltung bei Wundversorgung 30) - fehlt das
	     Fortschritts-Modlet, ist er offen und nichts bricht (D70). -->
	<append xpath="/recipes">
		<recipe name="itm700_eichenrindensud" count="1" craft_area="campfire" craft_tool="toolCookingPot" craft_time="20">
			<ingredient name="itm700_eichenrinde" count="2" />
			<ingredient name="drinkJarBoiledWater" count="1" />
		</recipe>
		<recipe name="itm700_honigsalbe" count="1" craft_time="10">
			<ingredient name="foodHoney" count="1" />
			<ingredient name="resourceAnimalFat" count="1" />
		</recipe>
		<recipe name="itm700_theriak" count="1" craft_area="campfire" craft_tool="toolCookingPot" craft_time="60">
			<ingredient name="foodHoney" count="2" />
			<ingredient name="drugHerbalAntibiotics" count="2" />
			<ingredient name="resourceCropGoldenrodPlant" count="2" />
		</recipe>

		<!-- F-19 Nahrung (Plan-0002 WP13.4, D202; zu pruefen N-143). Mehl aus der Hand wie
		     Vanillas Maismehl (zwischen zwei Steinen gerieben; ein eigener Mahlstein braucht
		     ein Modell), Fladenbrot im Kochtopf wie Vanillas Maisbrot, Met in der
		     Kraeuterkueche wie Vanillas Bier. Mehl ist offen wie das Maismehl; Fladenbrot und
		     Met sind gebunden wie ihre Vorlagen (Kochkunst 4 und 27, tags in
		     700_50_Fortschritt/recipes.xml) - fehlt das Fortschritts-Modlet, sind sie offen (D70). -->
		<recipe name="itm700_mehl" count="1" craft_time="10">
			<ingredient name="itm700_wildkorn" count="4" />
		</recipe>
		<recipe name="itm700_fladenbrot" count="1" craft_area="campfire" craft_tool="toolCookingPot" craft_time="30">
			<ingredient name="itm700_mehl" count="1" />
			<ingredient name="drinkJarBoiledWater" count="1" />
		</recipe>
		<recipe name="itm700_met" count="1" craft_area="chemistryStation" craft_time="60">
			<ingredient name="foodHoney" count="2" />
			<ingredient name="drinkJarBoiledWater" count="1" />
		</recipe>
	</append>
</config>
