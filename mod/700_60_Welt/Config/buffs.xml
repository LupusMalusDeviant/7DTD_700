<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_60_Welt / buffs.xml
	     F-17 Baustein B8 (sichere Orte), Plan-0001 WP8.3, D73

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     ===================================================================
	     AM FEUER
	     ===================================================================

	     B8 sagt, ein sicherer Ort "senkt das Grauen". Das Grauen (B3) gibt es in
	     Phase 1 nicht - es braucht eine Lichtabfrage am Spielerort, und die ist C#.
	     Was ein sicherer Ort bis dahin tut, hat der Nutzer am 2026-11-20 entschieden:
	     "Kleine Erholung" - eine sichtbare Wirkung und schnellere Ausdauer-Erholung.

	     ZWEI BUFFS, NICHT EINER - und das ist Vanillas Bauform, nicht unsere. Das Spiel
	     legt die Wirkung eines Blocks nur an, wenn der Spieler sie NICHT traegt
	     (EntityPlayerLocal.BlockRadiusEffectsApply: HasBuff, dann AddBuff). Der erste
	     Buff ist unsichtbar, haelt eine Sekunde und stoesst beim Start den zweiten an;
	     der zweite haelt zwei Sekunden und wird ersetzt. So laeuft der sichtbare nie
	     ab, solange man im Kreis steht, und flackert nicht - Vanillas Kommentar an
	     buffCampfireAOE sagt genau das. Die Dauern 1 und 2 sind von dort uebernommen.

	     DIE WAERME BLEIBT. Vanillas sichtbare Wirkung am Feuer (buffCampfireAOEEffect)
	     gibt Kaelteschutz +20. Unsere drei Feuerstellen zeigen kuenftig auf unsere
	     Aura statt auf Vanillas, also traegt 'Am Feuer' den Kaelteschutz selbst - sonst
	     waere das Feuer nach diesem Paket kaelter als davor.

	     DIE ZAHL IST EINE SETZUNG FUER WP9. +20 % Ausdauer-Erholung ist der Wert, den
	     Vanilla dem Kaffee gibt (buffCoffee, StaminaChangeOT perc_add 0.2): spuerbar,
	     aber kein Grund, einen Kampf am Feuer zu suchen.
	-->

	<append xpath="/buffs">

		<!-- Die Aura. Unsichtbar; der Block legt sie an, sie stoesst 'Am Feuer' an. -->
		<buff name="buff700_feuerstelle_aura" hidden="true">
			<stack_type value="ignore"/>
			<duration value="1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buff700_amfeuer"/>
			</effect_group>
		</buff>

		<!-- Am Feuer. Sichtbar. -->
		<buff name="buff700_amfeuer" name_key="buff700_amfeuerName" description_key="buff700_amfeuerDesc" icon="ui_game_symbol_campfire">
			<stack_type value="replace"/>
			<duration value="2"/>
			<effect_group>
				<passive_effect name="HypothermalResist" operation="base_add" value="20"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".2"/>
			</effect_group>
		</buff>

		<!-- ===================================================================
		     DAS GRAUEN (F-17 B3 "in Zahlen", D184/D185; Plan-0002 WP11.3; Vertrag 07 Nachtrag 4)
		     ===================================================================
		     buff700_grauenZaehlen ist der EINE Schreiber von cv700_grauen. Er zaehlt alle
		     5 Sekunden; die Raten aus F-17 stehen je Minute, hier also durch 12 geteilt:
		       +1/min = .0833   +2/min = .1667   +3/min = .25   +4/min = .3333
		     Zuerst .cv700_grauenZuwachs aus den Bedingungen, dann mal (1 - .cv700_grauenSchutz)
		     (den Schutz rechnet buff700_grauenSchutz in 700_75_Magie, Vertrag 07 N1.3), dann
		     .cv700_grauenAbbau abziehen, dann kappen. Treffer zaehlt ein Ausloeser in DIESEM Buff
		     auf .cv700_grauenTreffer; der naechste Takt nimmt sie mit.
		     Dunkel = CompareLightLevel unter 20. Ob das Spiel in Prozent oder als Bruch
		     vergleicht, ist ungelesen (S-34 (1)); als Bruch waere es immer dunkel, dann wird
		     die Zahl hier 0.2 - eine Stelle, drei Zeilen.
		     Allein zaehlt nur, wenn cv700_mitspielerDa = 1 ist (D118); den setzt der Direktor
		     (C#). Fehlt er, liest der Wert 0 und "allein" entfaellt.
		     Die Stufen kommen bei 30/60/85 und gehen bei 25/55/80. -->
		<buff name="buff700_grauenZaehlen" hidden="true" remove_on_death="false">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<update_rate value="5"/>
			<effect_group>
				<triggered_effect trigger="onOtherDamagedSelf" action="ModifyCVar" cvar=".cv700_grauenTreffer" operation="add" value="3"/>

				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="set" value="@.cv700_grauenTreffer"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenTreffer" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="add" value=".0833">
					<requirement name="IsNight"/>
					<requirement name="!IsSheltered"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="add" value=".1667">
					<requirement name="CompareLightLevel" operation="LT" value="20"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="add" value=".0833">
					<requirement name="CVarCompare" cvar="cv700_mitspielerDa" operation="Equals" value="1"/>
					<requirement name="!HasBuff" buff="buff700_gesellschaft"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="add" value=".1667">
					<requirement name="StatComparePercCurrentToMax" stat="health" operation="LT" value=".3"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="add" value=".3333">
					<requirement name="IsBloodMoon"/>
				</triggered_effect>
				<!-- Seuchennacht naht: cv700_grauenDruck (0 bis 30, Direktor) durch 10 je Minute,
				     je Takt also durch 120. -->
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenDruckTakt" operation="set" value="@cv700_grauenDruck"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenDruckTakt" operation="divide" value="120"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="add" value="@.cv700_grauenDruckTakt"/>

				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenFaktor" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenFaktor" operation="subtract" value="@.cv700_grauenSchutz"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenZuwachs" operation="multiply" value="@.cv700_grauenFaktor"/>

				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenAbbau" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenAbbau" operation="add" value=".25">
					<requirement name="!IsNight"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenAbbau" operation="add" value=".0833">
					<requirement name="IsSheltered"/>
					<requirement name="CompareLightLevel" operation="GTE" value="20"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenAbbau" operation="add" value=".3333">
					<requirement name="HasBuff" buff="buff700_amfeuer"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_grauenAbbau" operation="add" value=".0833">
					<requirement name="HasBuff" buff="buff700_gesellschaft"/>
				</triggered_effect>

				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_grauen" operation="add" value="@.cv700_grauenZuwachs"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_grauen" operation="subtract" value="@.cv700_grauenAbbau"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_grauen" operation="set" value="100">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="GT" value="100"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_grauen" operation="set" value="0">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="LT" value="0"/>
				</triggered_effect>

				<!-- Die Stufen, mit Abstand. -->
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_grauenUnruhig">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="GTE" value="30"/>
					<requirement name="!HasBuff" buff="buff700_grauenUnruhig"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buff700_grauenUnruhig">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="LT" value="25"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_grauenVeraengstigt">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="GTE" value="60"/>
					<requirement name="!HasBuff" buff="buff700_grauenVeraengstigt"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buff700_grauenVeraengstigt">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="LT" value="55"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_grauenGrauen">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="GTE" value="85"/>
					<requirement name="!HasBuff" buff="buff700_grauenGrauen"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buff700_grauenGrauen">
					<requirement name="CVarCompare" cvar="cv700_grauen" operation="LT" value="80"/>
				</triggered_effect>

				<!-- Panik beim Treffer, nur in der Stufe Grauen und nur auf "voll" (Daempfung 0). -->
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" buff="buff700_grauenPanik">
					<requirement name="HasBuff" buff="buff700_grauenGrauen"/>
					<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="Equals" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Die drei Stufen. Sichtbar; jede Wirkung fragt die Daempfung (Vertrag 07 3.2):
		     Mechanik nur bei 0 ("voll"), Bild bei 0 und 1 ("mild"), bei 2 ("aus") nichts.
		     Der Herzschlag fehlt: Vanilla hat keinen Laut dafuer, er kommt mit F-16.
		     Trugbilder (B4) lesen buff700_grauenVeraengstigt, kommen mit WP11.5. -->
		<buff name="buff700_grauenUnruhig" name_key="buff700_grauenUnruhig" description_key="buff700_grauenUnruhigDesc" icon="ui_game_symbol_skull" icon_color="200,200,160" remove_on_death="false">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="Equals" value="0"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value="-.1"/>
			</effect_group>
		</buff>
		<buff name="buff700_grauenVeraengstigt" name_key="buff700_grauenVeraengstigt" description_key="buff700_grauenVeraengstigtDesc" icon="ui_game_symbol_skull" icon_color="220,160,80" remove_on_death="false">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<update_rate value="30"/>
			<effect_group>
				<!-- Trugbilder (B4, WP11.5): alle 30 s ein Wurf, siehe buff700_trugSchritte. -->
				<requirement name="IsLocalPlayer"/>
				<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="LT" value="2"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_trugWurf" operation="set" value="randomint(1,100)"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_trugSchritte">
					<requirement name="CVarCompare" cvar=".cv700_trugWurf" operation="LTE" value="4"/>
					<requirement name="!IsIndoors"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="PlaySound" sound="rustle" play_in_head="true">
					<requirement name="CVarCompare" cvar=".cv700_trugWurf" operation="GT" value="4"/>
					<requirement name="CVarCompare" cvar=".cv700_trugWurf" operation="LTE" value="8"/>
					<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="Equals" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="PlaySound" sound="door_old_int_single_open" play_in_head="true">
					<requirement name="CVarCompare" cvar=".cv700_trugWurf" operation="GT" value="8"/>
					<requirement name="CVarCompare" cvar=".cv700_trugWurf" operation="LTE" value="10"/>
					<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="Equals" value="0"/>
					<requirement name="IsIndoors"/>
				</triggered_effect>
			</effect_group>
			<effect_group>
				<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="Equals" value="0"/>
				<passive_effect name="SpreadDegreesHorizontal" operation="perc_add" value=".25" tags="ranged,itm700_zauber"/>
				<passive_effect name="SpreadDegreesVertical" operation="perc_add" value=".25" tags="ranged,itm700_zauber"/>
			</effect_group>
		</buff>
		<buff name="buff700_grauenGrauen" name_key="buff700_grauenGrauen" description_key="buff700_grauenGrauenDesc" icon="ui_game_symbol_skull" icon_color="220,60,40" remove_on_death="false">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<update_rate value="30"/>
			<effect_group>
				<!-- Im Grauen ein zweiter Wurf je 30 s (B4 "staerkere Trugbilder"): Schritte oder
				     Rascheln doppelt so oft, nur auf "voll". -->
				<requirement name="IsLocalPlayer"/>
				<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="Equals" value="0"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_trugWurfGrauen" operation="set" value="randomint(1,100)"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_trugSchritte">
					<requirement name="CVarCompare" cvar=".cv700_trugWurfGrauen" operation="LTE" value="5"/>
					<requirement name="!IsIndoors"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="PlaySound" sound="rustle" play_in_head="true">
					<requirement name="CVarCompare" cvar=".cv700_trugWurfGrauen" operation="GT" value="5"/>
					<requirement name="CVarCompare" cvar=".cv700_trugWurfGrauen" operation="LTE" value="10"/>
				</triggered_effect>
			</effect_group>
			<effect_group>
				<requirement name="CVarCompare" cvar="cv700_grauenDaempfung" operation="LT" value="2"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Dark" intensity=".3" fade="2"/>
			</effect_group>
			<effect_group>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Dark" intensity="0" fade="2"/>
			</effect_group>
		</buff>
		<buff name="buff700_grauenPanik" name_key="buff700_grauenPanik" description_key="buff700_grauenPanikDesc" icon="ui_game_symbol_run">
			<stack_type value="replace"/>
			<duration value="3"/>
			<effect_group>
				<passive_effect name="RunSpeed" operation="perc_add" value=".1"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value="-.5"/>
			</effect_group>
		</buff>

		<!-- TRUGBILDER (F-17 B4, D187; Plan-0002 WP11.5), soweit Vanilla Laute hat.
		     Regeln aus B4: nur beim Betroffenen (IsLocalPlayer; PlaySound im Kopf, also nur
		     auf seinem Rechner), nie Schaden, nie ein Laut, der einen echten Gegner meldet
		     (D74: kein Stoehnen, kein Wolf). Vanillas Laute dafuer:
		       Schritte   barestepleaves - fuenf Schritte in drei Sekunden, nur draussen
		       Rascheln   rustle (der Laut eines Strauchs)
		       eine Tuer  door_old_int_single_open, nur drinnen
		     Haeufigkeit: Veraengstigt alle 30 s ein Wurf aus 100 - Schritte 4, Rascheln 4,
		     Tuer 2 (rund alle 5 Minuten etwas); auf "mild" nur die Schritte. Im Grauen ein
		     zweiter Wurf (Schritte 5, Rascheln 5). Fluestern, Klopfen, die Gestalt am Waldrand
		     und die flackernde Fackel brauchen eigene Laute und Bilder (F-16). Ob ein Laut
		     im Kopf keine Geraeusch-Marke fuer die Toten setzt, ist ungelesen [verifizieren
		     S-45] - setzt er eine, faellt der Trugbild-Laut weg. -->
		<buff name="buff700_trugSchritte" hidden="true">
			<stack_type value="ignore"/>
			<duration value="3"/>
			<update_rate value=".6"/>
			<effect_group>
				<requirement name="IsLocalPlayer"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="PlaySound" sound="barestepleaves" play_in_head="true"/>
			</effect_group>
		</buff>

		<!-- GESELLSCHAFT (F-17 Grundsatz 5; Finding WP9.4): jeder Spieler legt alle 2 s auf
		     die anderen Spieler in 10 m einen kurzen Buff. selfOtherPlayers statt selfAOE, damit
		     sich der Sender nicht selbst trifft [verifizieren S-34 (2)]. Im Einzelspiel gibt es
		     keinen anderen Spieler - der Buff kommt nie, und "allein" zaehlt dort nicht (D118). -->
		<buff name="buff700_gesellschaftSender" hidden="true" remove_on_death="false">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<update_rate value="2"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" target="selfOtherPlayers" range="10" buff="buff700_gesellschaft"/>
			</effect_group>
		</buff>
		<buff name="buff700_gesellschaft" name_key="buff700_gesellschaft" description_key="buff700_gesellschaftDesc" icon="ui_game_symbol_players">
			<stack_type value="replace"/>
			<duration value="3"/>
		</buff>

		<!-- DER STILLE BEGINN DER SEUCHENNACHT (F-09 Ausarbeitung 5, D12, D186; Vertrag 07
		     Nachtrag 4). Wird IsBloodMoon wahr, setzt sich jeder Spieler selbst
		     buff700_seuchennachtBeginn: 60 s nichts - dann EIN Glockenschlag (Vanillas
		     churchbellhit, der Laut der Kirchenglocke, im Kopf: fern und fuer jeden gleich) und
		     die Meldung "Die Glocke schlaegt.". buff700_seuchennachtGelaeutet sperrt ein zweites
		     Laeuten in derselben Nacht und geht, sobald IsBloodMoon falsch wird - so haengt
		     nichts an der Tageslaenge. Wer erst spaet in der Nacht ins Spiel kommt, hoert die
		     Glocke 60 s nach dem Betreten (Grenze, N-130). -->
		<buff name="buff700_seuchennachtBeginn" hidden="true">
			<stack_type value="ignore"/>
			<duration value="60"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffFinish" action="PlaySound" sound="churchbellhit" play_in_head="true"/>
				<triggered_effect trigger="onSelfBuffFinish" action="ShowToolbeltMessage" message_key="buff700_seuchennachtGlocke"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buff700_seuchennachtGelaeutet"/>
			</effect_group>
		</buff>
		<buff name="buff700_seuchennachtGelaeutet" hidden="true">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<update_rate value="10"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buff700_seuchennachtGelaeutet">
					<requirement name="!IsBloodMoon"/>
				</triggered_effect>
			</effect_group>
		</buff>

	</append>

	<!-- Zaehler und Gesellschaft setzt Vanillas buffStatusCheck01 (laeuft bei jedem Spieler
	     immer, auch nach dem Tod), wie die Odem-Buffs (Vertrag 07 Nachtrag 2). -->
	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_grauenZaehlen"><requirement name="!HasBuff" buff="buff700_grauenZaehlen"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_gesellschaftSender"><requirement name="!HasBuff" buff="buff700_gesellschaftSender"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_seuchennachtBeginn">
				<requirement name="IsBloodMoon"/>
				<requirement name="!HasBuff" buff="buff700_seuchennachtBeginn"/>
				<requirement name="!HasBuff" buff="buff700_seuchennachtGelaeutet"/>
			</triggered_effect>
		</effect_group>
	</append>

</config>
