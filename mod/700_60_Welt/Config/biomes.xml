<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_60_Welt / biomes.xml
	     F-17 Baustein B1 (Nebel), Plan-0001 WP8.2, D72

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     ===================================================================
	     NEBEL IN ZWEI BIOMEN - UND EIN DRITTES GIBT ES NICHT
	     ===================================================================

	     F-17 will Nebel "in Wald, Moor und Flusstaelern". Die Kulturzonen sitzen nach
	     D43 auf Vanillas Biomen: pine_forest ist das Klosterland (Wald), wasteland das
	     Moorland. Ein FLUSSTAL IST KEIN BIOM - Vanilla kennt fuenf an Land, und ein
	     Tal ist Gelaende, keine Wetterzone. Flusstal-Nebel ist darum nicht gebaut und
	     gehoert zu F-07 (Welt, Phase 2).

	     Geaendert werden nur Zahlen an Zeilen, die Vanilla schon fuehrt. Kein neues
	     Wetter, kein eigenes Spektrum (das zeigt auf Unity-Assets, Phase 2).

	     WALD (pine_forest)
	       Wetter 'default'   Fog 0-2   -> 1-5      ein Rest Dunst, auch bei klarem Wetter
	       Wetter 'default'   prob 83   -> 76
	       Wetter 'fog'       prob 7    -> 14       Nebel doppelt so oft
	       Wetter 'fog'       Fog 17-27 -> 20-32    und etwas dichter
	     Die sieben Punkte, die 'fog' gewinnt, gibt 'default' ab: die vier Wetter mit
	     prob > 0 zaehlen weiter zusammen 100 (76 + 14 + 6 + 4). Regen bleibt, wie er
	     ist. 'fog' fuehrt in Vanilla die ALTE Schreibweise min/max, 'default' die neue
	     range - beide bleiben, wie sie sind, nur die Zahlen aendern sich.

	     MOOR (wasteland)
	       Wetter 'default', 'cold', 'hot'   Fog 0-5 -> 6-14
	     Das Moor hat in Vanilla KEIN Nebelwetter, nur drei trockene Wetter mit
	     demselben duennen Dunst. "Dauerhafter Bodennebel" (F-07) heisst hier: alle
	     drei tragen einen Nebel, der nie auf null faellt. 6-14 liegt unter dem
	     Nebelwetter des Waldes (20-32) - im Moor ist es IMMER diesig, im Wald
	     MANCHMAL dicht. Regen und Sturm im Moor bleiben Vanilla.

	     WAS DIE ZAHLEN BEDEUTEN, IST NUR ZUR HAELFTE GEMESSEN. Der Wert ist ein
	     Prozentwert (WeatherManager.BiomeWeather.FogPercent), Vanillas dichtestes
	     Wetter ist 'twitch_fog' mit 35-45. Wie weit man bei 10 oder bei 30 SIEHT,
	     steht in keiner XML. Pruefliste 18.

	     NICHT ANGEFASST: das Brandland (burnt_forest, Fog 0-5 als Rauch), das
	     Mittelgebirge (snow, hat ein eigenes Nebelwetter 9-18) und die Kueste
	     (desert). Auch nicht: die Temperatur des Moors - Vanillas Wetter 'hot' fuehrt
	     dort 95 bis 105 Grad Fahrenheit, das ist Oedland und kein Moor. Gehoert zu
	     F-07, nicht zu F-17.
	-->

	<!-- Wald -->
	<set xpath="/worldgeneration/biomes/biome[@name='pine_forest']/weather[@name='default']/Fog/@range">1,5</set>
	<set xpath="/worldgeneration/biomes/biome[@name='pine_forest']/weather[@name='default']/@prob">76</set>
	<set xpath="/worldgeneration/biomes/biome[@name='pine_forest']/weather[@name='fog']/@prob">14</set>
	<set xpath="/worldgeneration/biomes/biome[@name='pine_forest']/weather[@name='fog']/Fog/@min">20</set>
	<set xpath="/worldgeneration/biomes/biome[@name='pine_forest']/weather[@name='fog']/Fog/@max">32</set>

	<!-- Moor -->
	<set xpath="/worldgeneration/biomes/biome[@name='wasteland']/weather[@name='default']/Fog/@range">6,14</set>
	<set xpath="/worldgeneration/biomes/biome[@name='wasteland']/weather[@name='cold']/Fog/@range">6,14</set>
	<set xpath="/worldgeneration/biomes/biome[@name='wasteland']/weather[@name='hot']/Fog/@range">6,14</set>

	<!-- ===================================================================
	     DEKOR DER FREIEN LANDSCHAFT: MINEN, WRACKS, REIFEN, FAESSER, MUELL
	     (Plan-0002 WP3.8, 23. November 2026, D144 - ZU PRUEFEN)
	     ===================================================================

	     Vanilla streut ausserhalb aller Orte Dinge ins Gelaende, die 700 nicht kennt.
	     GEZAEHLT an biomes.xml von V 3.40 b10 (je Zeile <decoration type="block">):

	       Moor (wasteland)      48   Radkappen- und Bonbondosen-Minen 12, Autowracks 8,
	                                  Radkappen 4, Reifen 1, Schlackensteine 12,
	                                  Schrotthaufen 4, Faesser 7
	       unter Wasser           4   Wrack, Radkappe, Reifen, Schlackenstein
	       Kueste (desert)        1   Autowrack
	       Brandland              2   Muellhaufen
	                             55   Zeilen, getroffen von den 30 Pfaden unten

	     Die Minen zuerst (Saeule P1: Sprengstoff): eine Tretmine im Moor ist kein
	     Folk-Horror, sondern ein Kriegsrest der Neuzeit.

	     <remove> auf eine Dekor-Zeile, nicht auf einen Block: die Zeile ist ein WEG
	     ins Gelaende, keine Definition (Vertrag 03 §4, wie die Abwuerfe). Jeder Block
	     bleibt stehen - in Orten, an Strassen und im Kreativmenue ist er weiter da.
	     Pfade absolut, ohne '//' (Vertrag 03 §8.2); ein Pfad trifft mit Absicht
	     mehrere Zeilen (je Unterbiom eine).

	     WAS DAS NICHT TUT
	       - Strassen und Orte bleiben, wie sie sind: die drei Strassen-'poi' in
	         dieser Datei streuen weiter Autos (carsRandomHelper), Reifen und
	         Schlackensteine. Das ist F-07 (Welt), nicht dieser Schritt.
	       - Die 28 Zeilen cnt...RandomLootHelper (ein zufaelliger Beutebehaelter je
	         Landschaft) sind nicht angefasst: was sie hinstellen, entscheidet der
	         Code (Klasse CompositeTileEntity), nicht diese Datei - nicht gelesen.
	       - Die 18 Kaktus-Zeilen der Kueste bleiben bis F-07.

	     FOLGE FUER DAS EISEN: Wracks (Ernte: Raseneisenerz, Tiegelstahl) und
	     Schrotthaufen (15 Raseneisenerz) fallen im offenen Moor weg. Strassen und
	     Orte fuehren sie weiter, Erzbrocken auch. Ob das Moor damit zu arm wird, ist
	     eine Balance-Frage und nicht gemessen (Entscheidungsliste N-39).

	     ANNAHME, im Spiel nicht gesehen: Dekor wird beim Erzeugen eines
	     Gelaendestuecks gesetzt; schon erzeugtes Gelaende eines alten Spielstands
	     behaelt, was dort steht. -->

	<!-- Moor: Minen -->
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='mineHubcap']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='mineCandyTin']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='mineHubcap']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='mineCandyTin']" />

	<!-- Moor: Wracks, Radkappen, Reifen -->
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='carWrecksRandomHelper']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='hubcapNoMine']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='carWrecksRandomHelper']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='carsRandomHelper']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='hubcapNoMine']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='decoCarTireSmallFlat']" />

	<!-- Moor: Schlackensteine, Schrotthaufen, Faesser -->
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='cinderBlocks01']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='cinderBlocks02']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='cinderBlocks03']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='scrapMetalPile']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='cntBarrelRadiatedSingle45']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/decorations/decoration[@blockname='cntBarrelAcidSingle45']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='cinderBlocks01']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='cinderBlocks02']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='cinderBlocks03']" />
	<remove xpath="/worldgeneration/biomes/biome[@name='wasteland']/subbiome/decorations/decoration[@blockname='scrapMetalPile']" />
