<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_20_Material / items.xml
	     F-05 Rohstoffe und F-04 Handwerk, Plan-0001 WP4.6

	     Die drei Glieder, die Vanilla in der Eisenkette fehlen. F-04 nennt den Weg:
	     Raseneisenerz + Holzkohle -> (Rennofen) Luppe -> (Esse) Schmiedeeisen ->
	     (Esse + Amboss) Klinge -> (Zimmermannsbank) Spatha. Raseneisenerz,
	     Schmiedeeisen und Holzkohle sind umgedeutete Vanilla-Gegenstaende (WP4.1);
	     Luppe, Klinge und Spatha gibt es in Vanilla nicht, weil Vanilla aus Schrott
	     direkt Schmiedeeisen macht.

	     VON HAND GESCHRIEBEN, nicht erzeugt: das ist eine Entscheidung und folgt aus
	     keiner Liste (D53 - 700_10_Purge nimmt weg, die anderen fuegen hinzu).

	     Alle drei erben von einem Vanilla-Gegenstand, statt jede Eigenschaft neu zu
	     setzen. Das ist Absicht und hat eine Grenze: Modell, Symbol, Gewicht und
	     Trefferwerte sind die des Vorfahren. Eine Spatha, die wie ein Jagdmesser
	     zuschlaegt, ist fuer die KETTE richtig und fuer das SPIELGEFUEHL falsch - das
	     richtet F-02/F-03 in WP5, die Zahlen WP9, Modell und Symbol Phase 2. Hier geht
	     es darum, dass der Pfad T0 -> T4 ohne Sackgasse existiert. -->

	<append xpath="/items">

		<!-- Luppe: der Eisenschwamm, der im Rennofen anfaellt - poroes, voller Schlacke,
		     noch kein Werkstoff. Erbt von resourceScrapIron (Raseneisenerz), weil sie auf
		     derselben Stufe steht: etwas, das erst ausgeschmiedet werden muss. -->
		<item name="itm700_luppe">
			<property name="Extends" value="resourceScrapIron" />
			<!-- Bild: der Erzbrocken, grau getoent - bis zum 2026-11-22 Vanillas Schrottbild
			     (Blech und Schrauben). Zu pruefen durch den Nutzer, siehe unten "Bilder im Beutel". -->
			<property name="CustomIcon" value="oreIronBoulder" />
			<property name="CustomIconTint" value="9aa3a8" />
			<property name="EconomicValue" value="24" />
			<property name="EconomicBundleSize" value="1" />
			<property name="Stacknumber" value="500" />
			<property name="CraftingIngredientTime" value="4" />
		</item>

		<!-- Klinge: ausgeschmiedet, noch ohne Griff und Scheide. Erbt von
		     resourceForgedIron (Schmiedeeisen) - sie ist ein Halbzeug, kein Werkzeug. -->
		<item name="itm700_klinge">
			<property name="Extends" value="resourceForgedIron" />
			<property name="CustomIcon" value="resourceForgedIron" />
			<property name="CustomIconTint" value="d8dee0" />
			<property name="EconomicValue" value="90" />
			<property name="Stacknumber" value="50" />
			<property name="CraftingIngredientTime" value="8" />
		</item>

		<!-- HIER STAND itm700_spatha, UND ER IST WEG (D58, 8. November 2026).

		     Er erbte vom Jagdmesser, weil die Machete gesperrt war - eine Spatha mit
		     der Reichweite, dem Schlag und der Animation eines Messers. Genau das stand
		     als Grenze im Kopf dieser Datei, und WP5 hat es nicht ertragen: gemessen hat
		     Vanilla kein anderes Klingenmodell ueber Messerlaenge, also gibt D58 die
		     Machete frei und deutet sie zur Spatha um - wie D54 die Boegen.

		     Die Spatha ist seitdem meleeWpnBladeT3Machete. Ihr Rezept steht in
		     700_30_Ausruestung/Config/recipes.xml (WP5.1) und hat dieselben Zutaten:
		     Klinge, Holz, Leder. Die Kette dieses Modlets endet an der Klinge; was aus
		     ihr wird, ist Sache von F-02. -->

	</append>

	<!-- ===================================================================
	     BELOHNUNGSBUENDEL: ZEHN BUENDEL BEKOMMEN EINEN INHALT, DER LEBT
	     ===================================================================
	     Balancing 0003 (docs/balancing/0003-sackgassen-und-belohnungen.md), vom
	     Nutzer am 22. November 2026 abgenommen (D89).

	     Der Purge sperrte alle 92 Belohnungsbuendel ueber EIN Namensmuster
	     (denylist.txt: questReward*Bundle). 20 davon sind seit D89 einzeln
	     freigegeben. Zehn tragen nur Lebendes und bleiben, wie Vanilla sie schreibt.
	     Die zehn hier nennen neben Lebendem auch Gesperrtes - und DAS SIEHT KEINE
	     PRUEFUNG: mod700check kennt als Weg zu einem Gegenstand Rezept, Loot,
	     Haendler, Auftragsbelohnung, Block-Abwurf und Startausruestung, nicht den
	     Inhalt eines Buendels (Create_item, Random_item). Ein freigegebenes Buendel
	     mit Mineralwasser darin bliebe gruen. Darum steht hier, was jedes Buendel
	     danach noch nennt, und der Vorlauf zaehlt es nach (Balancing 0003, Stand
	     des Baus).

	     GEAENDERT WIRD NUR DIE LISTE, nie das Buendel selbst: Symbol, Klasse und
	     Klang bleiben Vanilla. Wo eine Zufallsliste kuerzer wird, sinkt Random_count
	     mit - mit Unique_random_only="true" darf er die Zahl der Eintraege nicht
	     uebersteigen. Random_item_count nennt je Eintrag eine Zahl.

	     Die Namen der Buendel stehen in 700_90_Sprache. -->

	<!-- Feldbuendel 1 bis 3. Vanilla wuerfelt drei Setzlinge aus sechs, vier und drei
	     Sorten; es leben Pilz und Goldrute (1), Aloe (2), Hopfen (3). Es bleiben drei
	     Setzlinge je Buendel. Felder und Lehrblatt (Create_item) bleiben. -->
	<set xpath="/items/item[@name='questRewardFarmT1Bundle']/property[@class='Action0']/property[@name='Random_item']/@value">plantedMushroom1,plantedGoldenrod1</set>
	<set xpath="/items/item[@name='questRewardFarmT1Bundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">2,1</set>
	<set xpath="/items/item[@name='questRewardFarmT1Bundle']/property[@class='Action0']/property[@name='Random_count']/@value">2</set>
	<set xpath="/items/item[@name='questRewardFarmT2Bundle']/property[@class='Action0']/property[@name='Random_item']/@value">plantedAloe1</set>
	<set xpath="/items/item[@name='questRewardFarmT2Bundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">3</set>
	<set xpath="/items/item[@name='questRewardFarmT2Bundle']/property[@class='Action0']/property[@name='Random_count']/@value">1</set>
	<set xpath="/items/item[@name='questRewardFarmT3Bundle']/property[@class='Action0']/property[@name='Random_item']/@value">plantedHop1</set>
	<set xpath="/items/item[@name='questRewardFarmT3Bundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">3</set>
	<set xpath="/items/item[@name='questRewardFarmT3Bundle']/property[@class='Action0']/property[@name='Random_count']/@value">1</set>

	<!-- Speisebuendel (Vanillas Nahrungspaket 01). Abgekochtes Wasser statt
	     Mineralwasser; von sieben Gerichten leben zwei - Gemuese- und
	     Fleischeintopf, beide seit D89 wieder kochbar. Random_count bleibt 1. Die
	     Nahrungspakete 02 und 03 bleiben gesperrt: keines ihrer Gerichte lebt, ihre
	     Gruppen zahlen Silber (loot.xml in diesem Modlet). -->
	<set xpath="/items/item[@name='questRewardT2FoodBundle']/property[@class='Action0']/property[@name='Create_item']/@value">foodSkillMagazine,drinkJarBoiledWater</set>
	<set xpath="/items/item[@name='questRewardT2FoodBundle']/property[@class='Action0']/property[@name='Random_item']/@value">foodVegetableStew,foodMeatStew</set>
	<set xpath="/items/item[@name='questRewardT2FoodBundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">10,10</set>

	<!-- Abschriften-Buendel (Vanillas 3-Buecher-Paket). Von 126 Blaettern leben 78;
	     die 48 anderen gehoeren zu gesperrten Reihen und Blaettern (Schusswaffen,
	     Robotik, Kaffee, Zigarre). Drei Blaetter bleiben es. -->
	<set xpath="/items/item[@name='questRewardT1BookBundle']/property[@class='Action0']/property[@name='Random_item']/@value">bookRangersArrowRecovery,bookRangersCripplingShot,bookRangersKnockdown,bookRangersFlamingArrows,bookRangersAPAmmo,bookRangersExplodingBolts,bookRangersForestGuide,bookSpearHunter1Damage,bookSpearHunter2Maintenance,bookSpearHunter3Bleed,bookSpearHunter4KillMove,bookSpearHunter5RapidStrike,bookSpearHunter6PenetratingShaft,bookSpearHunter7QuickStrike,bookHuntingJournalBears,bookHuntingJournalCoyotes,bookHuntingJournalDeer,bookHuntingJournalMountainLions,bookHuntingJournalVultures,bookHuntingJournalWolves,bookHuntingJournalSelfDefense,bookArtOfMiningLuckyStrike,bookArtOfMiningDiamondTools,bookArtOfMiningPallets,bookArtOfMiningAvalanche,bookArtOfMiningDamage,bookBatterUpFoulBalls,bookBatterUpBigHits,bookBatterUpStealingBases,bookBatterUpKnockdown,bookBatterUpSlowPitch,bookBatterUpMaintenance,bookBatterUpMetalChain,bookWasteTreasuresAcid,bookWasteTreasuresCloth,bookWasteTreasuresCoffins,bookWasteTreasuresDoors,bookWasteTreasuresHoney,bookWasteTreasuresSinks,bookUrbanCombatAdrenalineRush,bookUrbanCombatRoomClearing,bookUrbanCombatJumping,bookUrbanCombatLandMines,bookUrbanCombatLanding,bookUrbanCombatSneaking,bookNightStalkerArchery,bookNightStalkerBlades,bookNightStalkerSilentNight,bookNightStalkerSlumberParty,bookNightStalkerStealthDamage,bookNightStalkerThiefAdrenaline,bookNightStalkerTwilightThief,bookFiremansAlmanacSpeed,bookFiremansAlmanacPrevention,bookFiremansAlmanacHarvest,bookFiremansAlmanacHeat,bookFiremansAlmanacMolotov,bookBarBrawling1BasicMoves,bookBarBrawling2DropABomb,bookBarBrawling3KillerInstinct,bookBarBrawling4FinishingMoves,bookBarBrawling5AdrenalineHealing,bookBarBrawling6RageMode,bookBarBrawling7BoozedUp,bookLuckyLooterAmmunition,bookLuckyLooterBooks,bookLuckyLooterBrass,bookLuckyLooterDukes,bookLuckyLooterFood,bookLuckyLooterLead,bookLuckyLooterMedical,bookGreatHeistAdrenalineFall,bookGreatHeistGoldRush,bookGreatHeistClaimed,bookGreatHeistGems,bookGreatHeistMotionDetection,bookGreatHeistSafes,bookGreatHeistSprintSneak</set>

	<!-- Aufsaetze fuer Nahkampfwaffen, Buendel 2. Von vier leben zwei (ohne
	     Stacheldraht und Bunkerbrecher). Die Buendel 1 und 3 nennen nur Lebendes
	     und bleiben unveraendert. -->
	<set xpath="/items/item[@name='questRewardT2MeleeModsBundle']/property[@class='Action0']/property[@name='Random_item']/@value">modMeleeClubBurningShaft,modMeleeFortifyingGrip</set>
	<set xpath="/items/item[@name='questRewardT2MeleeModsBundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">1,1</set>
	<set xpath="/items/item[@name='questRewardT2MeleeModsBundle']/property[@class='Action0']/property[@name='Random_count']/@value">2</set>

	<!-- Aufsaetze fuer Bogen und Armbrust, Buendel 1 und 2. Von elf lebt einer ('Der
	     Jaeger'), von zehn leben zwei (Pfeilauflage und 'Laehmschuss'); alles andere
	     gehoert an Schusswaffen. Buendel 3 bleibt gesperrt, seine Gruppe zahlt
	     Silber. -->
	<set xpath="/items/item[@name='questRewardT1RangedModsBundle']/property[@class='Action0']/property[@name='Random_item']/@value">modGunMeleeTheHunter</set>
	<set xpath="/items/item[@name='questRewardT1RangedModsBundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">1</set>
	<set xpath="/items/item[@name='questRewardT1RangedModsBundle']/property[@class='Action0']/property[@name='Random_count']/@value">1</set>
	<set xpath="/items/item[@name='questRewardT2RangedModsBundle']/property[@class='Action0']/property[@name='Random_item']/@value">modGunCrippleEm,modGunBowArrowRest</set>
	<set xpath="/items/item[@name='questRewardT2RangedModsBundle']/property[@class='Action0']/property[@name='Random_item_count']/@value">1,1</set>
	<set xpath="/items/item[@name='questRewardT2RangedModsBundle']/property[@class='Action0']/property[@name='Random_count']/@value">2</set>

	<!-- Fallenbuendel 1 und 2. Vanilla: Spiesse 5, Stacheldraht 5, zwei Sorten Minen
	     je 5, Fallen-Lehrblatt 3. Es leben nur die Spiesse (Holz, dann Eisen) -
	     dafuer zehn statt fuenf. -->
	<set xpath="/items/item[@name='questRewardT1TrapsBundle']/property[@class='Action0']/property[@name='Create_item']/@value">trapSpikesWoodDmg0</set>
	<set xpath="/items/item[@name='questRewardT1TrapsBundle']/property[@class='Action0']/property[@name='Create_item_count']/@value">10</set>
	<set xpath="/items/item[@name='questRewardT2TrapsBundle']/property[@class='Action0']/property[@name='Create_item']/@value">trapSpikesIronDmg0</set>
	<set xpath="/items/item[@name='questRewardT2TrapsBundle']/property[@class='Action0']/property[@name='Create_item_count']/@value">10</set>

	<!-- ====================================================================================
	     Bilder im Beutel (Nachtlauf 2026-11-22, ZU PRUEFEN DURCH DEN NUTZER; D92, D130).
	     Pruefung 0002 (docs/pruefung/0002-erscheinung.md, 4.3 und 8 Nr. 1): sechs Gegenstaende
	     der Kernwirtschaft tragen unseren Namen und zeigen ein Bild von heute - der
	     Silberpfennig einen Casino-Jeton mit Umschrift, das Raseneisenerz Blech und Schrauben,
	     der Leim eine Plastikflasche, das Naehzeug eine Garnspule mit Massband, der
	     Erste-Hilfe-Verband ein Kreuzzeichen, der Pergamentfetzen einen linierten Zettel.
	     CustomIcon nennt ein vorhandenes Bild aus Vanillas Data\ItemIcons (alle acht Dateien
	     am 2026-11-22 dort gesehen). Es aendert NUR das Bild im Beutel, nicht das Modell in
	     der Hand oder am Boden. Im Spiel hat es niemand gesehen.
	     Keinen brauchbaren Ersatz gibt es fuer Schmiedeeisen, Tiegelstahl und das Trinkglas -
	     die bleiben bis Phase 2 (F-16).
	     ==================================================================================== -->
	<!-- Silberpfennig: das ERSTE EIGENE Bild (Plan-0002 WP3.4, Vertrag 05). Es liegt als
	     UIAtlases\ItemIconAtlas\ico700_silberpfennig.png in diesem Modlet; dass das Spiel den
	     Ordner liest, ist gelesen (Finding F-16), aber im Spiel NICHT gesehen (S-09).
	     Bleibt das Feld im Beutel leer: zurueck auf value="resourceSilverNugget" mit
	     CustomIconTint e6dfc4 (Stand bis 2026-11-23). -->
	<append xpath="/items/item[@name='casinoCoin']">
		<property name="CustomIcon" value="ico700_silberpfennig" />
	</append>
	<append xpath="/items/item[@name='resourceScrapIron']">
		<property name="CustomIcon" value="oreIronBoulder" />
	</append>
	<append xpath="/items/item[@name='resourceGlue']">
		<property name="CustomIcon" value="resourceAnimalFat" />
		<property name="CustomIconTint" value="b98a4a" />
	</append>
	<append xpath="/items/item[@name='resourceSewingKit']">
		<property name="CustomIcon" value="resourceCloth" />
		<property name="CustomIconTint" value="c9d2e0" />
	</append>
	<append xpath="/items/item[@name='medicalFirstAidBandage']">
		<property name="CustomIcon" value="medicalBandage" />
	</append>
	<set xpath="/items/item[@name='noteDuke01']/property[@name='CustomIcon']/@value">resourcePaper</set>
</config>
