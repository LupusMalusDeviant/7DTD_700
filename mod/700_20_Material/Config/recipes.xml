<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_20_Material / recipes.xml
	     F-04 Beispielkette, Plan-0001 WP4.6

	     Raseneisenerz + Holzkohle -> (Rennofen) Luppe -> (Esse) Schmiedeeisen ->
	     (Esse + Amboss) Klinge -> (Zimmermannsbank) Spatha. Dazu Tiegelstahl per
	     Aufkohlen (T3).

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     WARUM HOLZKOHLE EINE ZUTAT IST UND KEIN BRENNSTOFF. D26 sagt "Vanilla-
	     Forge-Prinzip" fuer den Brennstoff, und das heisst: die Brennstoffkammer nimmt
	     alles, was eine FuelValue traegt - Holz 50, Holzkohle 100, dazu Stoff, Leder,
	     Fett, Federn. Holzkohle ist dort also nur doppelt so gut wie Holz, nicht
	     notwendig. Ohne Holzkohle kommt aber kein Eisen aus dem Erz; das ist der Kern
	     der Kette und nicht eine Frage der Geschwindigkeit. Darum steht sie als
	     ZUTAT in jedem Rezept der Kette. Der Brennstoffgrid bleibt Vanilla (D26), und
	     der Zwang steckt an der Stelle, an der die Pruefung ihn sehen kann.

	     WERKZEUG TRENNT RENNOFEN VON ESSE. F-04 nennt zwei Werkstaetten, Vanilla hat
	     einen Block mit drei Werkzeugslots (Blasebalg, Amboss, Schmelztiegel). Also
	     trennt das Werkzeug, nicht der Block: Luppe braucht den Blasebalg (Rennofen),
	     Schmiedeeisen und Klinge den Amboss (Esse), Tiegelstahl den Schmelztiegel.
	     Das ist genau "Werkzeugslots schalten bessere Rezepte frei" aus D26 und
	     braucht keinen neuen Block und kein neues XUi-Fenster.

	     KEINE MARKEN - UND SEIT WP7.5 IST DAS EINE ENTSCHEIDUNG (D70). Vanilla haengt
	     diese Rezepte an 'perkAdvancedEngineering', macht sie aber nicht 'learnable':
	     Schmiedeeisen und Stahl sind dort offen, und die Schranke ist das Werkzeug im
	     Ofen. Genau so bleibt es hier - die Kette ist offen, und wer sie gehen will,
	     braucht Blasebalg, Amboss und Schmelztiegel, die an der Stufe Werkstattbau
	     haengen. Gebunden wird in 700_50_Fortschritt/Config/recipes.xml und nur dort;
	     ein tags-Attribut in dieser Datei bricht den Erzeuger tools/gen/wp7-bindung.ps1
	     ab.

	     STUECKZAHLEN SIND SETZUNGEN FUER WP9. Zehn Erz und sieben Holzkohle je
	     Schmiedeeisen ist ein Anfangswert, kein Ergebnis eines Playtests. -->

	<!-- Vanillas Umweg faellt. Beide Rezepte machen aus Schrott bzw. aus der
	     Schmelzeinheit direkt Schmiedeeisen und wuerden die Luppe zur Zierde machen:
	     wer den kuerzeren Weg hat, nimmt ihn. Ein 'remove' auf einen Rezeptnamen
	     trifft beide Fassungen (use_smelter und replace_smelter) - mehrfacher Treffer
	     ist hier Absicht, Vertrag 03 Nachtrag WP3.2. Ein Rezept ist ein WEG, keine
	     Definition; D9 bleibt gewahrt. -->
	<remove xpath="/recipes/recipe[@name='resourceForgedIron']" />
	<remove xpath="/recipes/recipe[@name='resourceForgedSteel']" />

	<append xpath="/recipes">

		<!-- 1. Rennofen: Erz und Holzkohle werden zur Luppe. -->
		<recipe name="itm700_luppe" count="1" craft_area="forge" craft_tool="toolBellows"
		        is_trackable="false">
			<ingredient name="resourceScrapIron" count="10" />
			<ingredient name="resourceCoal" count="5" />
		</recipe>

		<!-- 2. Esse: die Luppe wird unter dem Hammer vom Schlackenanteil befreit. -->
		<recipe name="resourceForgedIron" count="1" craft_area="forge" craft_tool="toolAnvil"
		        is_trackable="false">
			<ingredient name="itm700_luppe" count="1" />
			<ingredient name="resourceCoal" count="2" />
		</recipe>

		<!-- 3. Esse mit Tiegel: Aufkohlen zu Tiegelstahl (T3). D55 - Stahl ist eine
		     Materialstufe, kein eigener Gegenstandsbaum. Damast (T4) kommt erst mit der
		     Meister-Abschrift und gehoert zu F-21 in WP7. -->
		<recipe name="resourceForgedSteel" count="1" craft_area="forge"
		        craft_tool="toolForgeCrucible" is_trackable="false">
			<ingredient name="resourceForgedIron" count="5" />
			<ingredient name="resourceCoal" count="10" />
		</recipe>

		<!-- 4. Esse und Amboss: die Klinge, noch ohne Griff. -->
		<recipe name="itm700_klinge" count="1" craft_area="forge" craft_tool="toolAnvil"
		        is_trackable="false">
			<ingredient name="resourceForgedIron" count="5" />
			<ingredient name="resourceCoal" count="2" />
		</recipe>

		<!-- 5. HIER STAND DAS SPATHA-REZEPT, und es ist nach 700_30_Ausruestung
		        gewandert (D58, 8. November 2026). Die Zutaten sind dieselben - Klinge,
		        Holz, Leder, Zimmermannsbank -, nur das Ergebnis heisst jetzt
		        meleeWpnBladeT3Machete statt itm700_spatha: die Machete ist freigegeben
		        und wird umgedeutet, statt dass die Spatha vom Jagdmesser erbt.

		        Dieses Modlet traegt die KETTE, nicht die Waffen (Vertrag 01: F-05/F-04
		        hier, F-02/F-03 in 700_30). Die Kette endet darum an der Klinge. -->

	</append>

	<!-- ===================================================================
	     SACKGASSEN: 10 VANILLA-REZEPTE BEKOMMEN ZEITGEMAESSE ZUTATEN, 2 FALLEN
	     ===================================================================
	     Balancing 0003 (docs/balancing/0003-sackgassen-und-belohnungen.md), vom
	     Nutzer am 22. November 2026 abgenommen (D89). Tabellen 1 und 3.

	     Gemessen am ConfigsDump vom 21. November: 80 Rezepte ueberleben den Purge
	     und nennen eine gesperrte Zutat. Hier stehen die 12 zu Werkstoff, Werkzeug
	     im Ofen und Kueche; 59 stehen in 700_30_Ausruestung, 9 in 700_40_Bauen.

	     Vanillas Rezept bleibt stehen - samt tags, Werkstatt und Zeit -, nur die
	     gesperrte Zutat geht. Derselbe Griff wie bei den Werkstaetten in
	     700_40_Bauen. Kein <recipe> und kein tags-Attribut an einem Rezept: die
	     Bindung in 700_50 bleibt unberuehrt.

	     DIE REGEL: Klebeband -> Leder, Mechanikteile -> Schmiedeeisen, Rohr -> Lehm,
	     Oel -> Holzkohle, Mais und Kartoffel -> Pilze und Goldrute. Steht der Ersatz
	     schon im Rezept, wird zusammengezaehlt. Alle Mengen sind Setzungen fuer WP9. -->

	<!-- Schiene. Vanilla: Tuch 10, Holz 2, KLEBEBAND 1. Ein Riemen haelt sie. -->
	<remove xpath="/recipes/recipe[@name='medicalSplint']/ingredient[@name='resourceDuctTape']" />
	<append xpath="/recipes/recipe[@name='medicalSplint']">
		<ingredient name="resourceLeather" count="1" />
	</append>

	<!-- Reparatursatz: ENTFAELLT seit dem Nachtlauf vom 22./23. November 2026 (zu
	     pruefen durch den Nutzer). Hier stand der Ersatz seiner Zutat (Klebeband ->
	     Leder, D89). Seit kein erlaubter Gegenstand mehr mit dem Reparatur-Kit flickt,
	     ist der Aufschub eingeloest und 700_10_Purge entfernt das Rezept ganz; eine
	     Operation darauf traefe nichts mehr. -->

	<!-- Blasebalg. Vanilla: Holz 6, Leder 20, ROHR 2, KLEBEBAND 5, Naegel 5. Die Duese
	     eines Blasebalgs am Rennofen ist aus Lehm; das Klebeband geht im Leder auf. -->
	<set xpath="/recipes/recipe[@name='toolBellows']/ingredient[@name='resourceLeather']/@count">25</set>
	<remove xpath="/recipes/recipe[@name='toolBellows']/ingredient[@name='resourceMetalPipe']" />
	<remove xpath="/recipes/recipe[@name='toolBellows']/ingredient[@name='resourceDuctTape']" />
	<append xpath="/recipes/recipe[@name='toolBellows']">
		<ingredient name="resourceClayLump" count="10" />
	</append>

	<!-- Schmelztiegel. Vanilla: Schmiedeeisen 100, MECHANIK 20, Bruchstein 1200, OEL
	     20, Lehm 900. Die Mechanikteile gehen im Schmiedeeisen auf; statt Oel brennt
	     Holzkohle den Tiegel. -->
	<set xpath="/recipes/recipe[@name='toolForgeCrucible']/ingredient[@name='resourceForgedIron']/@count">120</set>
	<remove xpath="/recipes/recipe[@name='toolForgeCrucible']/ingredient[@name='resourceMechanicalParts']" />
	<remove xpath="/recipes/recipe[@name='toolForgeCrucible']/ingredient[@name='resourceOil']" />
	<append xpath="/recipes/recipe[@name='toolForgeCrucible']">
		<ingredient name="resourceCoal" count="20" />
	</append>

	<!-- Dietrich und sein Buendel. Vanilla: Schmiedeeisen 1, MECHANIK 1 (Buendel: je
	     40). Ein Dietrich ist ein gebogener Eisenstift. -->
	<set xpath="/recipes/recipe[@name='resourceLockPick']/ingredient[@name='resourceForgedIron']/@count">2</set>
	<remove xpath="/recipes/recipe[@name='resourceLockPick']/ingredient[@name='resourceMechanicalParts']" />
	<set xpath="/recipes/recipe[@name='resourceLockPickBundle']/ingredient[@name='resourceForgedIron']/@count">80</set>
	<remove xpath="/recipes/recipe[@name='resourceLockPickBundle']/ingredient[@name='resourceMechanicalParts']" />

	<!-- Huehnerfutter. Vanilla: MAIS 1, verdorbenes Fleisch 1. -->
	<remove xpath="/recipes/recipe[@name='resourceChickenFeed']/ingredient[@name='foodCropCorn']" />
	<append xpath="/recipes/recipe[@name='resourceChickenFeed']">
		<ingredient name="foodCropMushrooms" count="1" />
	</append>

	<!-- Fleischeintopf. Vanilla: Bratfleisch 1, KARTOFFEL 2, MAIS 2, Talg 1, Wasser 1.
	     Kartoffel und Mais kommen aus Amerika; Pilze und Goldrute wachsen hier. -->
	<remove xpath="/recipes/recipe[@name='foodMeatStew']/ingredient[@name='foodCropPotato']" />
	<remove xpath="/recipes/recipe[@name='foodMeatStew']/ingredient[@name='foodCropCorn']" />
	<append xpath="/recipes/recipe[@name='foodMeatStew']">
		<ingredient name="foodCropMushrooms" count="2" />
		<ingredient name="resourceCropGoldenrodPlant" count="2" />
	</append>

	<!-- Gemueseeintopf. Vanilla: KARTOFFEL 2, MAIS 2, Pilze 2, Wasser 1. Die Kartoffel
	     geht in den Pilzen auf (2 + 2 = 4). -->
	<set xpath="/recipes/recipe[@name='foodVegetableStew']/ingredient[@name='foodCropMushrooms']/@count">4</set>
	<remove xpath="/recipes/recipe[@name='foodVegetableStew']/ingredient[@name='foodCropPotato']" />
	<remove xpath="/recipes/recipe[@name='foodVegetableStew']/ingredient[@name='foodCropCorn']" />
	<append xpath="/recipes/recipe[@name='foodVegetableStew']">
		<ingredient name="resourceCropGoldenrodPlant" count="2" />
	</append>

	<!-- Aschehuhn. Vanilla: Huhn 1, Pilze 2, MAIS 3, Holzkohle 1, Wasser 1. -->
	<remove xpath="/recipes/recipe[@name='foodAshChickenStew']/ingredient[@name='foodCropCorn']" />
	<append xpath="/recipes/recipe[@name='foodAshChickenStew']">
		<ingredient name="resourceCropGoldenrodPlant" count="3" />
	</append>

	<!-- Roter Tee FAELLT. Er verlangt die Chrysantheme, und die ist absichtlich
	     gesperrt (denylist.txt: Ostasien), kein Versehen. Goldrutentee gibt es schon.
	     Ein Rezept ist ein Weg, kein Gegenstand (Vertrag 03 Abschnitt 4). -->
	<remove xpath="/recipes/recipe[@name='drinkJarRedTea']" />

	<!-- Leim aus Supermais FAELLT - nur diese eine von Vanillas drei Fassungen. Das
	     Praedikat trifft die Fassung ueber ihre Zutat; Leim aus Knochen bleibt, an
	     Feuerstelle und Kraeuterkueche. -->
	<remove xpath="/recipes/recipe[@name='resourceGlue'][ingredient/@name='foodCropGraceCorn']" />
</config>
