<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_65_Wesen / entitygroups.xml
	     F-06 Seuchentote und Bestiarium, Plan-0002 WP5.4, D149

	     VON HAND GESCHRIEBEN, nicht erzeugt.

	     ===================================================================
	     DIESE DATEI SETZT EIN, SIE NIMMT NICHTS WEG
	     ===================================================================

	     Die neun neuzeitlichen Grundklassen (F-06 Abschnitt 3.1) und zwei Tiere
	     (Abschnitt 4) nimmt 700_10_Purge aus den Landschaftsgruppen - erzeugt
	     aus den Wesenregeln der Sperrliste, 72 Zeilen. Hier steht, was an ihre
	     Stelle rueckt. Drei Dinge, die das Spiel beim Laden verlangt (Finding
	     WP5.4, statisch gelesen):

	       - jede Klasse, die eine Gruppe nennt, muss es geben;
	       - keine Gruppe darf leer sein;
	       - jede Gruppe, die spawning.xml oder gamestages.xml ruft, muss es geben.

	     Darum fasst diese Datei nur EINTRAEGE an und nennt nur Vanilla-Klassen.
	     Eigene Klassen (ent700_...) und eigene Gruppen (eg700_...) kommen mit
	     WP5.5 und WP5.6.

	     Die Zahlen sind Vanillas Zahlen: der Nachruecker bekommt das Gewicht
	     dessen, der geht. Ob das im Spiel traegt, ist nicht gespielt (N-68, S-27).
	-->

	<!-- Sandheide bei Nacht. Vanilla: Rancher 1, RancherFeral 0.1, Biker 0.4,
	     BikerFeral 0.1. Ohne die beiden Biker blieben zwei Eintraege, beide
	     derselbe Mann. F-06 Abschnitt 3.1: faellt eine Gruppe unter drei Eintraege,
	     rueckt eine Klasse derselben Landschaft nach - zombieMoe steht in der
	     Sandheide bei Tag (ZombiesDesert). -->
	<append xpath="/entitygroups/entitygroup[@name='ZombiesDesertNight']">
		<e n="zombieMoe" p="0.4" />
		<e n="zombieMoeFeral" p="0.1" />
	</append>

	<!-- Der Wolf an der Stelle des Kojoten (F-06 Abschnitt 4). Beide Gruppen
	     fuehren in Vanilla keinen Wolf; er bekommt das Gewicht des Kojoten. -->
	<append xpath="/entitygroups/entitygroup[@name='EnemyAnimalsBurntForestNight']">
		<e n="animalWolf" p="5" />
	</append>
	<append xpath="/entitygroups/entitygroup[@name='EnemyAnimalsDesert']">
		<e n="animalWolf" p="20" />
	</append>

	<!-- Der Wolf an der Stelle des Bergloewen. Beide Gruppen fuehren den Wolf
	     schon; sein Gewicht waechst um das des Bergloewen (10 + 5, 5 + 10). -->
	<set xpath="/entitygroups/entitygroup[@name='EnemyAnimalsDesertNight']/e[@n='animalWolf']/@p">15</set>
	<set xpath="/entitygroups/entitygroup[@name='EnemyAnimalsSnow']/e[@n='animalWolf']/@p">15</set>

	<!-- Der Spukhund (WP5.5, D150; Klasse in entityclasses.xml dieses Modlets).
	     Nur in den beiden Nachtgruppen der freien Landschaft, und selten:
	     ZombiesNight (Klosterland, Brandland, Sandheide, Winterhoehen) hat nach
	     dem Purge ein Gesamtgewicht von 14.81 - mit 0.03 ist er rund jeder
	     fuenfhundertste Wurf; Vanillas Altwolf steht dort mit 0.01.
	     ZombiesWastelandNight (Moorland) hat 25 - mit 0.1 rund jeder
	     zweihundertfuenfzigste. Die Zahlen sind Setzungen (N-69). -->
	<append xpath="/entitygroups/entitygroup[@name='ZombiesNight']">
		<e n="ent700_spukhund" p="0.03" />
	</append>
	<append xpath="/entitygroups/entitygroup[@name='ZombiesWastelandNight']">
		<e n="ent700_spukhund" p="0.1" />
	</append>

	<!-- ===================================================================
	     SEUCHENNACHT: BRECHER UND ANFUEHRER (WP5.6, D151)
	     ===================================================================

	     Fuenf eigene Gruppen, die HEUTE NIEMAND RUFT. F-09 (WP11) haengt sie in
	     gamestages.xml ein; bis dahin aendern sie nichts im Spiel. Eine Gruppe,
	     die niemand ruft, laedt trotzdem: jede Klasse muss es geben, und keine
	     Gruppe darf leer sein (Finding F-06 Wesen-Gruppen).

	     BRECHER sind gemessen, nicht geraten: der Schaden an Bloecken steht am
	     Hand-Gegenstand der Klasse (items.xml, DamageBlock). In den 322 Gruppen
	     der Vanilla-Horde (feralHordeStageGS*) schlagen am staerksten:
	       Berstender (zombieDemolition)      500, und er birst
	       Verdammte aller Art                250
	       Buettel, Muhme (FatCop, FemaleFat) 100 / Verderbt 200 / Schwaerend 200
	       Hirte, Felswerfer                  100 / 200
	       Moorleiche                         100 / 140 / 180 / 200
	     Zum Vergleich: Knecht 8, Magd 7, Holzfaeller 20.
	     Hawaiihemd und Bowler schlagen wie der Buettel - sie sind aus der freien
	     Landschaft genommen (D149) und stehen darum auch hier nicht.

	     ANFUEHRER sind Sagengestalten (F-06 Abschnitt 5): Nachzehrer, Schreiende
	     und der Spukhund. Die Schreiende ruft Tote herbei; in einer Welle heisst
	     das MEHR Gegner - ob F-09 sie dort will, entscheidet der Einbau.

	     Die Gewichte sind Setzungen (N-70). -->
	<append xpath="/entitygroups">
		<entitygroup name="eg700_brecherFrueh">
			<e n="zombieFatCop" />
			<e n="zombieFemaleFat" />
			<e n="zombieRancher" p="0.5" />
			<e n="zombieMutated" p="0.5" />
			<e n="zombieChuck" p="0.3" />
		</entitygroup>
		<entitygroup name="eg700_brecherMittel">
			<e n="zombieFatCopFeral" />
			<e n="zombieFemaleFatFeral" />
			<e n="zombieRancherFeral" p="0.5" />
			<e n="zombieMutatedFeral" p="0.5" />
			<e n="zombieChuckFeral" p="0.3" />
			<e n="zombieFatCopRadiated" p="0.5" />
			<e n="zombieFemaleFatRadiated" p="0.5" />
			<e n="zombieRancherRadiated" p="0.3" />
			<e n="zombieMutatedRadiated" p="0.3" />
			<e n="zombieDemolition" p="0.05" />
		</entitygroup>
		<entitygroup name="eg700_brecherSpaet">
			<e n="zombieFatCopInfernal" />
			<e n="zombieFemaleFatInfernal" />
			<e n="zombieRancherInfernal" p="0.5" />
			<e n="zombieMutatedCharged" p="0.5" />
			<e n="zombieMutatedInfernal" p="0.5" />
			<e n="zombieChuckInfernal" p="0.3" />
			<e n="zombieDemolition" p="0.3" />
		</entitygroup>
		<entitygroup name="eg700_anfuehrerFrueh">
			<e n="zombieWightFeral" />
			<e n="ent700_spukhund" p="0.5" />
			<e n="zombieScreamer" p="0.3" />
		</entitygroup>
		<entitygroup name="eg700_anfuehrerSpaet">
			<e n="zombieWightRadiated" />
			<e n="zombieWightCharged" p="0.5" />
			<e n="zombieWightInfernal" p="0.5" />
			<e n="ent700_spukhund" p="0.5" />
			<e n="zombieScreamerFeral" p="0.3" />
			<e n="zombieScreamerRadiated" p="0.2" />
		</entitygroup>
	</append>
</config>
