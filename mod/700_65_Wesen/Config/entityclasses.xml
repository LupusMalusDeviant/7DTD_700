<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_65_Wesen / entityclasses.xml
	     F-06 Abschnitt 5 (Sagengestalten), Plan-0002 WP5.5, D150

	     VON HAND GESCHRIEBEN, nicht erzeugt.

	     ===================================================================
	     DER SPUKHUND - EINE EIGENE KLASSE AUF VANILLAS MODELL
	     ===================================================================

	     Vanillas animalZombieDog steht in 88 Gruppen und in allen fuenf
	     Landschaften; er heisst bei uns Seuchenhund und ist ein Alltagsgegner.
	     Der Spukhund - der Hund als Todesbote - ist darum eine EIGENE Klasse:
	     selten, nur nachts (entitygroups.xml), groesser und zaeher.

	     Was XML dafuer hergibt, gelesen am Code (Finding F-06 Farbe und Stufen):

	       extends    erbt Modell, Klaenge, Verhalten und Schlag vom Seuchenhund.
	                  Kein eigenes Asset, kein Bundle.
	       SizeScale  die Groesse des Modells. Vanilla benutzt sie beim Altwolf
	                  (animalDireWolf, 1.4).
	       MatColor   nennt einen <color>-Knoten dieser Datei beim Namen. Die
	                  Farbe geht als LEUCHTFARBE an die Materialien des Modells
	                  (so glimmen Vanillas Stufen gruen, blau und rot). Ein
	                  Abdunkeln des Fells gibt es in XML nicht - der "schwarze
	                  Hund" der Sage ist ohne eigenes Material nicht zu haben.

	     NICHT IM SPIEL GESEHEN (S-28). Ob das Hundematerial ueberhaupt leuchtet,
	     haengt an seinem Shader; tut es das nicht, unterscheidet den Spukhund
	     nur die Groesse. Fehlt der <color>-Knoten, den MatColor nennt, bricht das
	     Spiel beim ERSCHEINEN des Wesens - darum stehen Farbe und Klasse in
	     einem append.

	     DIE ZAHLEN SIND SETZUNGEN (N-69): 400 Lebenspunkte (Seuchenhund 200,
	     Altwolf 3000), Groesse 1.2, fahles Blauweiss mit einfacher Leuchtkraft.
	-->
	<append xpath="/entity_classes">
		<color name="col700_spuk" value=".55,.75,1, 0" />

		<entity_class name="ent700_spukhund" extends="animalZombieDog">
			<property name="MatColor" value="col700_spuk" />
			<property name="SizeScale" value="1.2" />
			<effect_group name="Base Effects">
				<passive_effect name="HealthMax" operation="base_set" value="400" />
				<passive_effect name="BuffResistance" operation="base_set" value="5" tags="buffRadiationPool" />
			</effect_group>
		</entity_class>
	</append>

	<!-- ===================================================================
	     DER LAUSCHER (F-17 B6, D188; Plan-0002 WP11.7)
	     ===================================================================
	     "Reagiert stark auf Geraeusche, schwach auf Sicht." Der Lauscher ist keine neue
	     Klasse, sondern ein Wesen, das es schon gibt: der Seuchentote Aussaetzige
	     (zombieMaleHazmat, D147) - unter der Kapuze sieht er schlecht. Seine vier Stufen
	     (verderbt, schwaerend, glutaeugig, verdammt) erben von ihm (extends).
	     Er traegt die Werte bisher nicht selbst, sondern erbt sie von zombieTemplateMale;
	     darum werden sie ANGEHAENGT, nicht gesetzt. Vanillas eigene Kommentare sagen,
	     was sie heissen:
	       SightRange            30 -> 12   Meter, so weit er sieht
	       SleeperNoiseToSense  3,8 -> 2,5  ab welchem Geraeusch ein Schlaefer etwas hoert
	       SleeperNoiseToWake  9,12 -> 6,8  ab welchem Geraeusch er aufwacht
	       SleeperSightToWakeMax 340,480 -> 500,640  wie hell man am Rand der Sicht sein muss
	     Dazu AINoiseSeekDist 6 -> 12 (gesetzt, er traegt ihn selbst). Was der Wert genau
	     misst, ist nicht gelesen - der Name sagt "wie weit er einem Geraeusch nachgeht"
	     [verifizieren S-46]. Alle Zahlen sind Setzungen (N-132). -->
	<append xpath="/entity_classes/entity_class[@name='zombieMaleHazmat']">
		<property name="SightRange" value="12" />
		<property name="SleeperNoiseToSense" value="2,5" />
		<property name="SleeperNoiseToWake" value="6,8" />
		<property name="SleeperSightToWakeMax" value="500,640" />
	</append>
	<set xpath="/entity_classes/entity_class[@name='zombieMaleHazmat']/property[@name='AINoiseSeekDist']/@value">12</set>

	<!-- ===================================================================
	     SCHUTZ JE SCHADENSART (F-02 Ausarbeitung Phase 2 Abschnitt 1, D193; Plan-0002 WP12.4)
	     ===================================================================
	     Vanilla hat keinen Schutz je Art (PiercingProtection ist in items.xml
	     auskommentiert), aber Schutz je MARKE DER WAFFE: animalInsectSwarm traegt
	     PhysicalDamageResist mit tags="ranged". Die Marken stehen schon an Vanillas Waffen:
	       Schnitt  bladeSkill, axe, knife
	       Stich    spearSkill, bowSkill, crossbow
	       Wucht    clubSkill, sledgeSkill, blunt
	     Eine EIGENE effect_group je Klasse, damit Vanillas "Base Effects" unberuehrt bleibt.
	     Angehaengt nur an die Grundklassen. Ob Feral, Radiated und die Klassen, die von
	     ihnen erben (Moorleiche von Buettel, Hirte-Speier von Hirte, Berstender von
	     Krieger), die Gruppe mitbekommen, ist nicht gelesen [verifizieren S-48].
	     Alle Zahlen sind Setzungen (N-137). -->

	<!-- Seuchentoter Krieger: traegt Kette - Schnitt prallt ab, die Spitze findet die Ringe -->
	<append xpath="/entity_classes/entity_class[@name='zombieSoldier']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="15" tags="bladeSkill,axe,knife" />
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="-5" tags="spearSkill,bowSkill,crossbow" />
		</effect_group>
	</append>

	<!-- Brecher (WP5.6): schwer, die Keule prallt ab -->
	<append xpath="/entity_classes/entity_class[@name='zombieFatCop']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="10" tags="clubSkill,sledgeSkill,blunt" />
		</effect_group>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieFemaleFat']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="10" tags="clubSkill,sledgeSkill,blunt" />
		</effect_group>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieRancher']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="10" tags="clubSkill,sledgeSkill,blunt" />
		</effect_group>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieChuck']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="10" tags="clubSkill,sledgeSkill,blunt" />
		</effect_group>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieFrostclaw']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="10" tags="clubSkill,sledgeSkill,blunt" />
		</effect_group>
	</append>

	<!-- Kriecher: weich und am Boden - schneiden ja, schlagen kaum -->
	<append xpath="/entity_classes/entity_class[@name='zombieSteveCrawler']">
		<effect_group name="eff700_schadensarten">
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="-10" tags="bladeSkill,axe,knife" />
			<passive_effect name="PhysicalDamageResist" operation="base_add" value="10" tags="clubSkill,sledgeSkill,blunt" />
		</effect_group>
	</append>
</config>
