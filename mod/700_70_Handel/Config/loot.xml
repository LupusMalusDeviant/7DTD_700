<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_70_Handel / loot.xml
	     Plan-0002 WP6.7, erzaehlende Umgebung (F-17 B7), D158. Zu pruefen durch den Nutzer (N-103).

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     Eine Beute-Gruppe lg700_schriften zieht genau EINE der zwoelf (seit WP11.9 achtzehn) Fundschriften. Sie steht
	     vor Vanillas erster Gruppe, damit jeder Verweis auf sie nach ihr kommt.

	     Angehaengt wird sie an sieben Vanilla-Gruppen, alle mit count="all": dort ist jeder
	     Eintrag ein eigener Wurf, ein neuer Eintrag nimmt den anderen nichts weg. Die Chance
	     kommt aus Vanillas Wahrscheinlichkeits-Vorlagen (force_prob, so schreibt Vanilla
	     seine eigenen Zusatzwuerfe):

	       groupDesks        Schreibpulte       lower   10 %
	       groupBookcase     Buecherborde       low     20 %
	       groupBookPile     Buecherstapel      low     20 %
	       groupCoffins      Saerge             low     20 %
	       groupCaskets      Totenladen         low     20 %
	       groupRottenChest  morsche Truhen     veryLow  5 %
	       groupZpackReg     Beutel der Toten   veryLow  5 %

	     Alle Zahlen sind Setzungen fuer das Balancing (WP14.3). Keine der sieben Gruppen
	     nimmt 700_10_Purge weg (gezaehlt: 0 Treffer in dessen loot.xml). -->

	<insertBefore xpath="/lootcontainers/lootgroup[@name='groupScrapCommon']">
		<lootgroup name="lg700_schriften" count="1">
			<item name="itm700_schriftMoench1" />
			<item name="itm700_schriftMoench2" />
			<item name="itm700_schriftMoench3" />
			<item name="itm700_schriftKerbholz" />
			<item name="itm700_schriftBrunnen" />
			<item name="itm700_schriftHaendler" />
			<item name="itm700_schriftBann" />
			<item name="itm700_schriftHirte" />
			<item name="itm700_schriftKoehler" />
			<item name="itm700_schriftSiebteNacht" />
			<item name="itm700_schriftBitte" />
			<item name="itm700_schriftKarren" />
			<!-- WP11.9 (D190): die drei Deutungen der Seuchennacht, je zwei -->
			<item name="itm700_schriftGlockenseil" />
			<item name="itm700_schriftBeichte" />
			<item name="itm700_schriftGrenzstein" />
			<item name="itm700_schriftKnoten" />
			<item name="itm700_schriftKraeuterfrau" />
			<item name="itm700_schriftWeitgereist" />
		</lootgroup>
	</insertBefore>

	<append xpath="/lootcontainers/lootgroup[@name='groupDesks']">
		<item group="lg700_schriften" loot_prob_template="lower" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupBookcase']">
		<item group="lg700_schriften" loot_prob_template="low" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupBookPile']">
		<item group="lg700_schriften" loot_prob_template="low" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupCoffins']">
		<item group="lg700_schriften" loot_prob_template="low" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupCaskets']">
		<item group="lg700_schriften" loot_prob_template="low" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupRottenChest']">
		<item group="lg700_schriften" loot_prob_template="veryLow" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupZpackReg']">
		<item group="lg700_schriften" loot_prob_template="veryLow" force_prob="true" />
	</append>

	<!-- ================================================================
	     BEUTE IN 700 (Plan-0002 WP8.6, D121, D165; F-05 "Beute in 700"). Zu pruefen (N-110).

	     Gemessen am Vorlauf (stand-r): 240 von 1017 Beutegruppen geben nach dem Purge
	     nichts mehr her. Die meisten sind Twitch, Fahrzeug, Strom, Schusswaffe - dort
	     gehoert nichts hin. Sechs leere Gruppen tragen aber Vanillas Alltagsbeute und
	     werden von vielen Behaeltern gezogen; sie bekommen Dinge der Zeit. Die Gruppe
	     bleibt, Eintraege kommen dazu (wie 700_20_Material bei den Belohnungen).

	       Gruppe              Verweise  vorher (Vanilla)          jetzt
	       groupMedicalRare        23    Verbandskasten, Pillen     Salbenverband, Kraeutersud, Schiene
	       groupFoodUncommon       21    Konserven                  Honig, Eintoepfe, gekochtes Fleisch
	       groupAmmoLarge          20    Patronen (Gruppen leer)    Pfeile und Bolzen, selten ein Buendel
	       groupDrinksRare         10    Kaffee, Limonade, Schnaps  Bier, Goldruten- und roter Tee
	       groupAllArmor            5    60 Ruestungsteile          unsere zwoelf (Leder, Stepp, Kette)
	       groupScrapRare           3    Kuehler                    Buntmetall

	     groupAllArmor ziehen groupArmorScaled und groupArmorChests - also Kleiderschrank,
	     Kleiderstaender, Ruestungsstaender, Truhen der Soldaten. Vorher stand unsere
	     Ruestung in KEINER Beute. Kette ist selten (veryLow), Eisen ist knapp (D31).

	     Leer bleiben bewusst: foodCandy (Suessigkeiten mit Wirkung, kein Gegenstueck),
	     groupToolsT3 (Motorsaege, Bohrer - Werkzeug der dritten Stufe gibt es in 700 nicht).
	     Alle Mengen und Chancen sind Setzungen fuer das Balancing (WP14.3). -->

	<append xpath="/lootcontainers/lootgroup[@name='groupMedicalRare']">
		<item name="medicalFirstAidBandage" />
		<item name="drugHerbalAntibiotics" loot_prob_template="low" />
		<item name="medicalSplint" />
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupFoodUncommon']">
		<item name="foodHoney" />
		<item name="foodMeatStew" />
		<item name="foodVegetableStew" />
		<item name="foodBoiledMeat" />
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupAmmoLarge']">
		<item name="ammoArrowStone" count="15,25" loot_stage_count_mod="0.01" />
		<item name="ammoArrowIron" count="10,20" loot_stage_count_mod="0.01" loot_prob_template="low" />
		<item name="ammoCrossbowBoltStone" count="10,20" loot_stage_count_mod="0.01" />
		<item name="ammoCrossbowBoltIron" count="8,15" loot_stage_count_mod="0.01" loot_prob_template="low" />
		<item name="ammoBundleArrowStone" count="1" loot_prob_template="veryLow" />
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupDrinksRare']">
		<item name="drinkJarBeer" />
		<item name="drinkJarGoldenRodTea" />
		<item name="drinkJarRedTea" />
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupAllArmor']">
		<item name="itm700_lederwams" />
		<item name="itm700_lederkappe" />
		<item name="itm700_wollhandschuhe" />
		<item name="itm700_wickelschuhe" />
		<item name="itm700_gambeson" loot_prob_template="low" />
		<item name="itm700_stepphaube" loot_prob_template="low" />
		<item name="itm700_stepphandschuhe" loot_prob_template="low" />
		<item name="itm700_steppschuhe" loot_prob_template="low" />
		<item name="itm700_kettenhemd" loot_prob_template="veryLow" />
		<item name="itm700_spangenhelm" loot_prob_template="veryLow" />
		<item name="itm700_armschienen" loot_prob_template="veryLow" />
		<item name="itm700_beinschienen" loot_prob_template="veryLow" />
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupScrapRare']">
		<item name="resourceScrapBrass" count="2,5" />
	</append>

	<!-- WP10.5d (D181): die Reliquienkapsel, nur Beute (F-15, Vertrag 01 Teil 2b). F-15 sagt
	     "in Kloestern und Kirchen"; Vanilla hat keine Kloster-Truhe, aber Saerge und Totenladen
	     stehen in Kirchen und auf Friedhoefen. Sehr selten (veryLow, 5 %), als eigener Wurf wie
	     die Fundschriften oben. Zu pruefen (N-125). -->
	<append xpath="/lootcontainers/lootgroup[@name='groupCoffins']">
		<item name="itm700_reliquienkapsel" loot_prob_template="veryLow" force_prob="true" />
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupCaskets']">
		<item name="itm700_reliquienkapsel" loot_prob_template="veryLow" force_prob="true" />
	</append>
</config>
