<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_70_Handel / traders.xml
	     Plan-0002 WP8.3, Sortimente je Posten (F-10 Ausarbeitung B, D159, D162).
	     Zu pruefen durch den Nutzer (N-107).

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     Jeder Vanilla-Haendler hat zwei Bloecke trader_items: der ERSTE ist sein Schwerpunkt,
	     der zweite die allgemeine Ware, die alle fuehren. Hier wird nur der erste ersetzt -
	     geleert und neu gefuellt, nach dem Posten aus F-10 B. Der zweite bleibt, wie ihn
	     700_10_Purge laesst. Neue Warengruppen gibt es keine; genannt werden Vanillas Gruppen
	     (nach dem Purge) und einzelne Gegenstaende, darunter unsere Ruestung, die vorher bei
	     keinem Haendler stand (die Ruestungsgruppen sind nach dem Purge leer).

	       id 8 Rekt  Klosterland  Klostermarkt   Heilmittel, Kraeuter, Abschriften, Saatgut
	       id 6 Bob   Sandheide    Marktflecken   Nahrung, Trank, Rohstoffe, Werkzeug, Farben
	       id 7 Hugh  Winterhoehen Fuerstenhof    Waffen, Geschosse, Ruestung, Aufsaetze
	       id 2 Jen   Brandland    Koehlerhof     Werkzeug, Holzkohle und Eisen, Schmiedebedarf
	       id 1 Joel  Moorland     Faehrhof       Vorrat, Pfeile und Federn, Heilmittel

	     Oeffnungszeit 5:00 bis 20:00 statt 4:05 bis 21:50 (F-10 C, Vorschlag).
	     Mengen und Chancen sind Setzungen fuer das Balancing (WP14.3). -->

	<!-- ==== Oeffnungszeit -->
	<set xpath="/traders/trader_info[@id='1' or @id='2' or @id='6' or @id='7' or @id='8']/@open_time">5:00</set>
	<set xpath="/traders/trader_info[@id='1' or @id='2' or @id='6' or @id='7' or @id='8']/@close_time">20:00</set>

	<!-- ==== Schwerpunkt leeren (Vertrag 03: remove ist fuer Haendler-Warengruppen erlaubt) -->
	<remove xpath="/traders/trader_info[@id='1' or @id='2' or @id='6' or @id='7' or @id='8']/trader_items[1]/item"/>

	<!-- ==== Klostermarkt (Rekt) -->
	<append xpath="/traders/trader_info[@id='8']/trader_items[1]">
		<item name="resourceCropAloeLeaf" count="2,5" />
		<item name="medicalAloeCream" count="2,5" />
		<item group="medicine" unique_only="true" count="3,5" />
		<item name="foodHoney" count="1,3" />
		<item group="seeds" count="2,4" />
		<item group="perkBooks" count="1,3" />
		<item group="skillMagazines" unique_only="true" count="4" />
		<item name="drinkJarEmpty" count="5,10" />
		<item group="cookingPotsQ1" count="1,2" />
		<!-- WP10.5d (D181): der Kreuzanhaenger, nur hier (F-15, Vertrag 01 Teil 2b) -->
		<item name="itm700_kreuzanhaenger" prob="0.5" />
	</append>

	<!-- ==== Marktflecken (Bob) -->
	<append xpath="/traders/trader_info[@id='6']/trader_items[1]">
		<item group="foodSupplies" count="3,5" />
		<item group="preparedFood" count="2,4" />
		<item group="groupDrinks" count="2,4" />
		<item group="seeds" count="2,4" />
		<item group="generalResources" count="3,5" />
		<item name="resourceSewingKit" count="1,3" />
