		<!-- WP10.5d (D181): Bernstein (F-05, F-10 B "Marktflecken ... Bernstein"); bis die
		     Kueste eine eigene Karte hat, der einzige Weg zu ihm -->
		<item name="itm700_bernstein" count="1,4" prob="0.6" />
	</append>

	<!-- ==== Fuerstenhof (Hugh) -->
