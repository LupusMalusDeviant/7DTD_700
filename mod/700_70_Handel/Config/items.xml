<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_70_Handel / items.xml
	     Plan-0002 WP6.7, erzaehlende Umgebung (F-17 B7), D158. Zu pruefen durch den Nutzer (N-103).

	     VON HAND GESCHRIEBEN, nicht erzeugt (D53).

	     Zwoelf Fundschriften (seit WP11.9 achtzehn, siehe unten). Jede erbt von Vanillas blankNoteMaster (Buch-Modell in der Hand,
	     Gruppe Sondergegenstaende, nicht verkaeuflich) und traegt ihren Text als Beschreibung:
	     gelesen wird im Info-Fenster des Gegenstands, die Schrift bleibt erhalten. Anders als
	     der Pergamentfetzen (noteDuke01) hat sie keine Aktion, die sie verbraucht.

	     Symbol: das des Pergamentfetzens, bis eigene Symbole kommen (WP3.6).
	     Keine realen Gebete, Heiligen oder Orden (D108). -->

	<append xpath="/items">
