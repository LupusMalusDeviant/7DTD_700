<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_75_Magie / items.xml
	     F-15 Volksmagie, Plan-0002 WP10.4, D177

	     VON HAND GESCHRIEBEN.

	     ZWEI GRUNDSTOFFE (F-15 "Ressourcen und Werkstatt"), aus dem, was es schon gibt (P5):
	     - Runenkreide: F-15 sagt "Kalk + Ocker + Asche". Ocker gibt es nicht als Stoff; der
	       Lehm (resourceClayLump) ist die rote Erde, aus der man Ocker schlaemmt. Asche gibt es
	       auch nicht; Holzkohle gibt das Schwarz. Also Branntkalk, Lehm, Holzkohle.
	     - Glutstein: F-15 sagt "Holzkohle + Harz". Harz gibt es nicht; Tierfett bindet die
	       Kohle ebenso und brennt. Erbt von der Holzkohle und brennt darum wie sie - das
	       braucht der Kraftstein spaeter (D37, WP10.7).
	     Beide Abweichungen sind zu pruefen (N-121).

	     ZWEI WERKZEUGE fuer die Plaetze der Bank. Voll ausgeschrieben nach Vanillas
	     Bratrost (toolCookingGrill), OHNE Extends: der Rost traegt die Marke
	     toolCookingGrill, und geerbt waere unser Messer an der Feuerstelle ein Rost. -->
	<append xpath="/items">

		<item name="itm700_runenkreide">
			<property name="Extends" value="resourceCement" />
			<property name="CustomIcon" value="resourceCement" />
			<property name="CustomIconTint" value="e6d3a8" />
			<property name="EconomicValue" value="12" />
			<property name="EconomicBundleSize" value="1" />
			<property name="Stacknumber" value="250" />
			<property name="CraftingIngredientTime" value="2" />
		</item>

		<item name="itm700_glutstein">
			<property name="Extends" value="resourceCoal" />
			<property name="CustomIcon" value="resourceCoal" />
			<property name="CustomIconTint" value="d9784a" />
			<property name="EconomicValue" value="10" />
			<property name="EconomicBundleSize" value="1" />
			<property name="Stacknumber" value="250" />
			<property name="CraftingIngredientTime" value="2" />
		</item>

		<item name="itm700_ritzmesser">
			<property name="CreativeMode" value="Player" />
			<property name="Tags" value="itm700_ritzmesser,scrap100" />
			<property name="HoldType" value="45" />
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab" />
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
			<property name="Material" value="Miron" />
			<property name="Stacknumber" value="1" />
			<property name="EconomicValue" value="120" />
			<property name="EconomicSellScale" value=".5" />
			<property name="Group" value="Tools/Traps" />
			<property name="CustomIcon" value="meleeWpnBladeT0BoneKnife" />
			<property name="CustomIconTint" value="c8c8c8" />
			<property name="DescriptionKey" value="itm700_ritzmesserDesc" />
			<effect_group>
				<passive_effect name="ModSlots" operation="base_set" value="0" />
			</effect_group>
		</item>

		<item name="itm700_meissel">
			<property name="CreativeMode" value="Player" />
			<property name="Tags" value="itm700_meissel,scrap100" />
			<property name="HoldType" value="45" />
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab" />
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
			<property name="Material" value="Miron" />
			<property name="Stacknumber" value="1" />
			<property name="EconomicValue" value="120" />
			<property name="EconomicSellScale" value=".5" />
			<property name="Group" value="Tools/Traps" />
			<property name="CustomIcon" value="resourceNail" />
			<property name="CustomIconTint" value="a0a0a0" />
			<property name="DescriptionKey" value="itm700_meisselDesc" />
			<effect_group>
				<passive_effect name="ModSlots" operation="base_set" value="0" />
			</effect_group>
		</item>

		<!-- WP10.5b (D179): VIER TRAENKE UND SALBEN (F-15 "Traenke und Salben").
		     Kein Odem, jeder darf sie trinken (F-15 Abgrenzung); gebraut in der Kraeuterkueche
		     (chemistryStation), freigeschaltet beim Heiler ueber die Wundversorgung
		     (craftingMedical, 700_50_Fortschritt). Voll ausgeschrieben nach Vanillas
		     drinkJarRedTea bzw. medicalAloeCream, OHNE Extends: geerbt kaemen deren
		     Wasser- und Heilwirkung mit.
		     Glas und Topf: der Krug ist Vanillas Glas (Meshfile), wie beim abgekochten Wasser
		     auch. Ein eigener Tonkrug ist ein Asset (F-16) und Phase-2-Arbeit fuer spaeter.
		     Die Dauer steht fest im Buff (stack_type replace: ein zweiter Trank setzt die Zeit
		     neu, verlaengert nicht - F-15 "Stapeln"). Vanillas CVar-Dauer ueber den Stoffwechsel
		     brauchen wir nicht. Zu pruefen: N-123. -->

		<item name="itm700_eulenauge">
			<property name="Tags" value="medical,itm700_trank" />
			<property name="HoldType" value="3" />
			<property name="Meshfile" value="@:Other/Items/Food/masonJarRedTeaPrefab.prefab" />
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
			<property name="Material" value="Mglass" />
			<property name="Stacknumber" value="10" />
			<property name="EconomicValue" value="90" />
			<property name="Group" value="Science,CFMedical,Medical,TCMedical" />
			<property name="CustomIcon" value="drinkJarRedTea" />
			<property name="CustomIconTint" value="7f8fd6" />
			<property name="DescriptionKey" value="itm700_eulenaugeDesc" />
			<property name="SoundPickup" value="jars_grab" />
			<property name="SoundPlace" value="jars_place" />
			<property class="Action0">
				<property name="Class" value="Eat" />
				<property name="Delay" value="4" />
				<property name="Sound_start" value="player_drinking" />
				<property name="Create_item" value="drinkJarEmpty" />
				<property name="Use_jar_refund" value="true" />
			</property>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buff700_eulenauge" />
			</effect_group>
		</item>

		<item name="itm700_baerenmut">
			<property name="Tags" value="medical,itm700_trank" />
			<property name="HoldType" value="3" />
			<property name="Meshfile" value="@:Other/Items/Food/masonJarRedTeaPrefab.prefab" />
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
			<property name="Material" value="Mglass" />
			<property name="Stacknumber" value="10" />
			<property name="EconomicValue" value="110" />
			<property name="Group" value="Science,CFMedical,Medical,TCMedical" />
			<property name="CustomIcon" value="drinkJarRedTea" />
			<property name="CustomIconTint" value="b5652e" />
			<property name="DescriptionKey" value="itm700_baerenmutDesc" />
			<property name="SoundPickup" value="jars_grab" />
			<property name="SoundPlace" value="jars_place" />
			<property class="Action0">
				<property name="Class" value="Eat" />
				<property name="Delay" value="4" />
				<property name="Sound_start" value="player_drinking" />
				<property name="Create_item" value="drinkJarEmpty" />
				<property name="Use_jar_refund" value="true" />
			</property>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buff700_baerenmut" />
			</effect_group>
		</item>

		<!-- Die Salbe: Vanillas Aloe-Salbe (HoldType, Ton), aber nur auf sich selbst - kein
		     zweiter Griff "auf andere" (F-11 Heilkunde fuer andere kommt mit dem Wundarzt). -->
		<item name="itm700_wolfsbalsam">
			<property name="Tags" value="medical,itm700_trank" />
			<property name="HoldType" value="64" />
			<property name="Meshfile" value="@:Other/Items/Health/bandage.FBX" />
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
			<property name="Material" value="Morganic" />
			<property name="Stacknumber" value="10" />
			<property name="EconomicValue" value="70" />
			<property name="Group" value="Science,CFMedical,Medical,TCMedical" />
			<property name="CustomIcon" value="medicalAloeCream" />
			<property name="CustomIconTint" value="9fae6a" />
			<property name="DescriptionKey" value="itm700_wolfsbalsamDesc" />
			<property name="SoundPickup" value="aloe_grab" />
			<property name="SoundPlace" value="aloe_place" />
			<property class="Action0">
				<property name="Class" value="Eat" />
				<property name="Delay" value="1.5" />
				<property name="Sound_start" value="player_ointment" />
			</property>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buff700_wolfsbalsam" />
			</effect_group>
		</item>

		<!-- Quellsud: +20 Odem, dann 10 min Abklingzeit (Vertrag 07 N1.1, N1.2). Die
		     Bedingungen stehen IN der Aktion (ExecutionRequirements, Finding WP9.5): solange
		     die Abklingzeit laeuft oder wer gar keinen Odem hat (cv700_odemMax 0, also kein
		     Runenkundiger ab Stufe 2), wird nicht getrunken - der Sud bleibt im Beutel statt
		     verschwendet. Gekappt bei cv700_odemMax; den setzt erst WP10.6, bis dahin bleibt
		     der Sud gesperrt. Ob die Sperre eine Meldung zeigt: S-38. -->
		<item name="itm700_quellsud">
			<property name="Tags" value="medical,itm700_trank" />
			<property name="HoldType" value="3" />
			<property name="Meshfile" value="@:Other/Items/Food/masonJarRedTeaPrefab.prefab" />
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab" />
			<property name="Material" value="Mglass" />
			<property name="Stacknumber" value="10" />
			<property name="EconomicValue" value="140" />
			<property name="Group" value="Science,CFMedical,Medical,TCMedical" />
			<property name="CustomIcon" value="drinkJarBoiledWater" />
			<property name="CustomIconTint" value="9fd3e0" />
			<property name="DescriptionKey" value="itm700_quellsudDesc" />
			<property name="SoundPickup" value="jars_grab" />
			<property name="SoundPlace" value="jars_place" />
			<property class="Action0">
				<property name="Class" value="Eat" />
				<property name="Delay" value="4" />
				<property name="Sound_start" value="player_drinking" />
				<property name="Create_item" value="drinkJarEmpty" />
				<property name="Use_jar_refund" value="true" />
				<requirement name="!HasBuff" buff="buff700_quellsudAbklingen" />
				<requirement name="CVarCompare" cvar="cv700_odemMax" operation="GT" value="0" />
			</property>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="cv700_odem" operation="add" value="20" />
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="cv700_odem" operation="set" value="@cv700_odemMax">
					<requirement name="CVarCompare" cvar="cv700_odem" operation="GT" value="@cv700_odemMax" />
				</triggered_effect>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buff700_quellsudAbklingen" />
			</effect_group>
		</item>

	</append>
</config>
