<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_75_Magie / XUi_InGame/windows.xml
	     F-15, Plan-0002 WP10.4, D177

	     VON HAND GESCHRIEBEN. Das Werkzeugfenster der Runenritzer-Bank, abgeschrieben von
	     Vanillas windowToolsCampfire: dieselbe Groesse, derselbe Gitter-Controller, nur zwei
	     Plaetze statt drei und unsere zwei Werkzeuge. 'required_tools_only' laesst nichts
	     anderes in die Plaetze. Name mit Praefix 700_ (Vertrag 02 Paragraf 2, XUi-Element). -->
	<append xpath="/windows">
		<window name="700_windowToolsRunenritzer" width="228" height="121" panel="Right" cursor_area="true">
			<rect style="header.panel">
				<headerbg />
				<sprite style="header.icon" sprite="ui_game_symbol_star" />
				<label style="header.name.shrink" text="TOOLS" text_key="xuiTools" />
			</rect>
			<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
				<grid name="inventory" depth="1" rows="1" cols="2" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true" required_tools="itm700_ritzmesser,itm700_meissel" required_tools_only="true">
					<item_stack controller="RequiredItemStack" name="0" />
				</grid>
			</rect>
		</window>
	</append>

	<!-- WP10.6 (D182): DIE ODEM-LEISTE (F-15 "Anzeige", D5 additiv, Vertrag 07 Nachtrag 2).
	     Ein schmaler Balken ueber den Balken links unten, in Vanillas Gestalt der
	     Ausdauer-Leiste, aber ohne Vanillas Controller (der kennt nur seine Stat-Arten). Die
	     Werte kommen aus der Bindung {cvar(...)} - die gibt es im Spiel (BindingItemCvar,
	     BindingsManager::ReplaceCVars; Finding WP10.6). Vanillas XUi nutzt sie nicht, also
	     sind Schreibweise und Zahlformat [verifizieren, S-41].
	     Sichtbar nur mit Odem: JEDES Teil ist ein gefuelltes Bild, dessen Fuellung
	     .cv700_odemZeigen (0 oder 1) ist - ohne Runenkunde ab Stufe 2 bleibt der Platz leer.
	     Keine Zahl im Balken: eine Zahl laesst sich nicht ausblenden, ohne die Sichtbarkeit an
	     eine Rechnung zu binden, deren Schreibweise ungeprueft ist. Platz: ueber dem
	     Schleich-Balken, der nur beim Schleichen erscheint; nichts von Vanilla rueckt. -->
	<append xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud']">
		<rect name="700_odem" width="171" height="16" pos="0,22">
			<sprite depth="1" name="700_odemRand" color="0,0,0,128" type="filled" fillspritepad="true" fill="{cvar(.cv700_odemZeigen:0)}" />
			<sprite depth="2" name="700_odemGrund" color="70,70,70,160" width="169" type="filled" fillspritepad="true" fill="{cvar(.cv700_odemZeigen:0)}" />
			<sprite depth="3" name="700_odemFuellung" color="214,150,50,200" width="169" type="filled" fillspritepad="true" fill="{cvar(.cv700_odemAnteil:0.00)}" />
			<sprite depth="4" name="700_odemZeichen" sprite="ui_game_symbol_wind" size="14,14" pos="10,-8" pivot="center" type="filled" fill="{cvar(.cv700_odemZeigen:0)}" foregroundlayer="true" />
		</rect>
	</append>
</config>
