<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_75_Magie / XUi_InGame/windows.xml
	     F-15, Plan-0002 WP10.4, D177

	     VON HAND GESCHRIEBEN. Das Werkzeugfenster der Runenritzer-Bank, abgeschrieben von
	     Vanillas windowToolsCampfire: dieselbe Groesse, derselbe Gitter-Controller, nur zwei
	     Plaetze statt drei und unsere zwei Werkzeuge. 'required_tools_only' laesst nichts
	     anderes in die Plaetze. Name mit Praefix 700_ (Vertrag 02 Paragraf 2, XUi-Element). -->
	<append xpath="/windows">
		<window name="700_windowToolsRunenritzer" width="228" height="121" panel="Right" cursor_area="true">
			<rect style="header.panel">
				<headerbg />
				<sprite style="header.icon" sprite="ui_game_symbol_star" />
				<label style="header.name.shrink" text="TOOLS" text_key="xuiTools" />
			</rect>
			<rect name="content" depth="0" pos="0,-46" height="75" disablefallthrough="true">
				<grid name="inventory" depth="1" rows="1" cols="2" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationToolGrid" repeat_content="true" required_tools="itm700_ritzmesser,itm700_meissel" required_tools_only="true">
					<item_stack controller="RequiredItemStack" name="0" />
				</grid>
			</rect>
		</window>
	</append>

	<!-- WP10.6 (D182): DIE ODEM-LEISTE (F-15 "Anzeige", D5 additiv, Vertrag 07 Nachtrag 2).
	     Ein schmaler Balken ueber den Balken links unten, in Vanillas Gestalt der
	     Ausdauer-Leiste, aber ohne Vanillas Controller (der kennt nur seine Stat-Arten).
	     SEIT D199 (2026-11-23, Spieltest S-41): eigener Controller XUiC_OdemLeiste in Mod700.dll
	     (700_00_Core). Die Bindung {cvar(...)} der ersten Fassung zeigte nichts: sie haengt
	     sich an den naechsten eigenen Controller darueber und wird nur aufgefrischt, wenn der
	     seine Bindungen neu liest - das tut ueber dem Balken niemand laufend (Finding
	     WP10-odem-leiste, Nachtrag). Der Controller liest .cv700_odemAnteil und
	     .cv700_odemZeigen viermal je Sekunde (gerechnet wird weiter im Buff) und gibt
	     {odemanteil} (Zahl mit Punkt) und {odemzeigen} (true/false). Ohne 700_00_Core fehlt
	     der Controller; das Spiel nimmt dann den leeren Grund-Controller, und die Leiste bleibt
	     unsichtbar (D70: nichts bricht).
	     Sichtbar nur mit Odem (Runenkunde ab Stufe 2). Keine Zahl im Balken (Vertrag 07
	     Nachtrag 2). Alle Teile auf der obersten Ebene (foregroundlayer), wie das Zeichen.
	     Nur der Bereich ohne Controller: HUDLeftStatBars hat ZWEI rect name="hud" (Statusbalken
	     und die Buff-Liste mit BuffPopoutList) - ohne die Einschraenkung erschien die Leiste
	     doppelt (Spieltest S-41, 2026-11-23).
	     PLATZ (Nutzer, 2026-11-23: "Ueber Ausdauer"): direkt ueber dem Ausdauer-Balken (der
	     beginnt bei -54), 1 Punkt Luft. Dort erscheint beim Schleichen Vanillas Schleich-Balken
	     (0 bis -46) - darum blendet der Controller die Leiste waehrend des Schleichens aus. Die
	     Buff-Liste rueckt dafuer um 12 nach oben (pos 90,132 -> 90,144); sonst lag die Leiste
	     ueber dem untersten Buff-Symbol. Die 12 sind am Bildschirmfoto des Spieltests geschaetzt
	     (zu pruefen).
	     PLATZHALTER (Nutzer, 2026-11-23): Lage und Aussehen gelten, bis die Oberflaeche ihre
	     eigene Gestalt bekommt (F-16). -->
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud'][@controller='BuffPopoutList']/@pos">90,144</set>
	<append xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud'][not(@controller)]">
		<rect name="700_odem" width="171" height="16" pos="0,-37" controller="Mod700.OdemLeiste, Mod700" visible="{odemzeigen}">
			<sprite depth="1" name="700_odemRand" color="0,0,0,128" type="filled" fillspritepad="true" fill="1" foregroundlayer="true" />
			<sprite depth="2" name="700_odemGrund" color="70,70,70,160" width="169" type="filled" fillspritepad="true" fill="1" foregroundlayer="true" />
			<sprite depth="3" name="700_odemFuellung" color="214,150,50,200" width="169" type="filled" fillspritepad="true" fill="{odemanteil}" foregroundlayer="true" />
			<sprite depth="4" name="700_odemZeichen" sprite="ui_game_symbol_wind" size="14,14" pos="10,-8" pivot="center" foregroundlayer="true" />
		</rect>
	</append>
</config>
