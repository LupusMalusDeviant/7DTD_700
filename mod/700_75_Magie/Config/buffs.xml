<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_75_Magie / buffs.xml
	     F-15 Volksmagie, Plan-0002 WP10.5a, D178; Vertrag 07 Nachtrag 1 (N1.4)

	     VON HAND GESCHRIEBEN.

	     buff700_brand: der Brand der Glutrune (spaeter auch Glutpfeil, Glutzeichen). Drei
	     Sekunden, 4 Leben je Sekunde = 12. Nach dem Muster von Vanillas buffBurningMolotov
	     (damage_type heat, HealthChangeOT), aber OHNE dessen Flammenbild (buffIsOnFire) -
	     D10: dezent. Ein eigenes Glimmen kommt mit F-16. Haelt der Brand noch, setzt ein neuer
	     Treffer die Zeit neu (stack_type replace). -->
	<append xpath="/buffs">

		<buff name="buff700_brand" hidden="true">
			<damage_type value="heat" />
			<stack_type value="replace" />
			<duration value="3" />
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_subtract" value="4" />
			</effect_group>
		</buff>

		<!-- WP10.5b (D179): die Buffs der vier Traenke (F-15 "Traenke und Salben"). Feste Dauer,
		     stack_type replace: derselbe Trank setzt die Zeit neu (F-15 "Stapeln"). -->

		<!-- Eulenauge, 5 min: Vanillas Nachtsicht-Bild (NightVision, sonst am Helm-Aufsatz mit
		     Staerke 1) mit einem Drittel der Staerke. F-15 will "etwas besser, ohne gruenes Bild" -
		     ob ein Drittel noch gruen ist, zeigt erst S-38; dann wird die Zahl kleiner oder ein
		     anderer Weg gesucht. -->
		<buff name="buff700_eulenauge" name_key="itm700_eulenauge" description_key="buff700_eulenaugeDesc" icon="ui_game_symbol_candy_eye_candy">
			<stack_type value="replace" />
			<duration value="300" />
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="NightVision" intensity=".33" fade="1" />
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="NightVision" intensity="0" fade="1" />
			</effect_group>
		</buff>

		<!-- Baerenmut, 3 min: +10 % Nahkampfschaden. Die -15 % Grauen-Zuwachs schreibt dieser
		     Buff NICHT selbst: buff700_grauenSchutz (WP11) zaehlt ihn per HasBuff mit (Vertrag
		     07 N1.3). Danach 2 min Erschoepfung: Ausdauer kommt 10 % langsamer zurueck. Nur wenn
		     die Zeit ablaeuft (onSelfBuffFinish); wer nachtrinkt, schiebt sie auf, entgeht ihr
		     aber nicht. -->
		<buff name="buff700_baerenmut" name_key="itm700_baerenmut" description_key="buff700_baerenmutDesc" icon="ui_game_symbol_berserker">
			<stack_type value="replace" />
			<duration value="180" />
			<effect_group>
				<passive_effect name="EntityDamage" operation="perc_add" value=".1" tags="melee" />
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buff700_baerenmutNach" />
			</effect_group>
		</buff>

		<buff name="buff700_baerenmutNach" name_key="buff700_baerenmutNach" description_key="buff700_baerenmutNachDesc" icon="ui_game_symbol_fatigued">
			<stack_type value="replace" />
			<duration value="120" />
			<effect_group>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value="-.1" />
			</effect_group>
		</buff>

		<!-- Wolfsbalsam, 2 min: +1 Leben je 5 s = 24 Leben. -->
		<buff name="buff700_wolfsbalsam" name_key="itm700_wolfsbalsam" description_key="buff700_wolfsbalsamDesc" icon="ui_game_symbol_add">
			<stack_type value="replace" />
			<duration value="120" />
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_add" value=".2" />
			</effect_group>
		</buff>

		<!-- Abklingzeit des Quellsuds, 10 min, sichtbar (Vertrag 07 N1.2). Bleibt ueber einen
		     Neustart, wenn Vanilla laufende Buffs mit Restzeit speichert - Indiz, S-38. -->
		<buff name="buff700_quellsudAbklingen" name_key="buff700_quellsudAbklingen" description_key="buff700_quellsudAbklingenDesc" icon="ui_game_symbol_clock">
			<stack_type value="ignore" />
			<duration value="600" />
		</buff>

		<!-- WP10.5c (D180): Segen und Fluch (F-15 "Segen und Flueche"). -->

		<!-- Segen der Wehr, 90 s: -12 % erlittener Schaden, nach Vanillas Fort-Bites
		     (GeneralDamageResist base_add). -->
		<buff name="buff700_segenWehr" name_key="itm700_segenWehr" description_key="buff700_segenWehrDesc" icon="ui_game_symbol_defense">
			<stack_type value="replace" />
			<duration value="90" />
			<effect_group>
				<passive_effect name="GeneralDamageResist" operation="base_add" value=".12" />
			</effect_group>
		</buff>
		<buff name="buff700_segenWehrAbklingen" name_key="buff700_segenWehrAbklingen" description_key="buff700_segenAbklingenDesc" icon="ui_game_symbol_clock">
			<stack_type value="ignore" />
			<duration value="180" />
		</buff>

		<!-- Totensegen, 60 s: Seuchentote nehmen dich schlechter wahr. Die Wahrnehmung der
		     Wesen lesen Vanillas Werte LightMultiplier und NoiseMultiplier (Perk
		     "Aus dem Schatten", Schleich-Ruestung): je -15 %. Keine Meide-Zone (Finding WP9.5).
		     [verifizieren, S-39]: merkt man es? -->
		<buff name="buff700_totensegen" name_key="itm700_totensegen" description_key="buff700_totensegenDesc" icon="ui_game_symbol_specters_grace">
			<stack_type value="replace" />
			<duration value="60" />
			<effect_group>
				<passive_effect name="LightMultiplier" operation="perc_add" value="-.15" />
				<passive_effect name="NoiseMultiplier" operation="perc_add" value="-.15" />
			</effect_group>
		</buff>
		<buff name="buff700_totensegenAbklingen" name_key="buff700_totensegenAbklingen" description_key="buff700_segenAbklingenDesc" icon="ui_game_symbol_clock">
			<stack_type value="ignore" />
			<duration value="240" />
		</buff>

		<!-- Fluch der Schwere, 30 s, auf dem getroffenen Wesen (Vertrag 07 N1.4): -15 % Tempo.
		     Verborgen: ein Seuchentoter zeigt keine Symbole. Geht beim Neustart verloren. -->
		<!-- WP10.6 (D182): DER ODEM (F-15 "Odem", Vertrag 07 N1.1).
		     Zwei Buffs, die immer laufen, verborgen, bleiben ueber den Tod:
		     buff700_odemStufe  ALLEIN schreibt cv700_odemMax und .cv700_odemRegen.
		       odemMax = 10 je Stufe der Runenkunde ab Stufe 2 (Stufe 1 = 0), dazu Odemtiefe
		       +10 je Rang. Erholung 0,25 je Sekunde, am Feuer 0,5, mit dem Bernsteinamulett
		       x1,15 (WornItems, wie Vanilla seine Abzeichen zaehlt). Ohne Odem keine Erholung.
		     buff700_odemRegen  zaehlt die Erholung auf cv700_odem, kappt bei odemMax und
		       schreibt die zwei Anzeigewerte der Leiste (.cv700_odemAnteil 0..1,
		       .cv700_odemZeigen 0/1; Vertrag 07 Nachtrag 2).
		     Beide setzt Vanillas buffStatusCheck01 (laeuft immer, auch nach dem Tod), sobald sie
		     fehlen - unten am Ende der Datei. Die Reihenfolge der Zeilen ist die Rechnung: jede
		     Zeile ueberschreibt die vorige, wenn ihre Bedingung gilt. -->
		<buff name="buff700_odemStufe" hidden="true" remove_on_death="false">
			<stack_type value="ignore" />
			<duration value="0" />
			<update_rate value="1" />
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="0" />
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="20"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="2" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="30"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="3" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="40"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="4" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="50"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="5" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="60"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="6" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="70"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="7" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="80"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="8" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="90"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="9" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="set" value="100"><requirement name="ProgressionLevel" progression_name="att700_runenkundiger" operation="GTE" value="10" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="add" value="10"><requirement name="ProgressionLevel" progression_name="prk700_odemtiefe" operation="GTE" value="1" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="add" value="10"><requirement name="ProgressionLevel" progression_name="prk700_odemtiefe" operation="GTE" value="2" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odemMax" operation="add" value="10"><requirement name="ProgressionLevel" progression_name="prk700_odemtiefe" operation="GTE" value="3" /></triggered_effect>

				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemRegen" operation="set" value=".25" />
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemRegen" operation="set" value=".5"><requirement name="HasBuff" buff="buff700_amfeuer" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemRegen" operation="multiply" value="1.15"><requirement name="WornItems" tags="amulett700_bernstein" operation="GTE" value="1" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemRegen" operation="set" value="0"><requirement name="CVarCompare" cvar="cv700_odemMax" operation="LTE" value="0" /></triggered_effect>
			</effect_group>
		</buff>

		<buff name="buff700_odemRegen" hidden="true" remove_on_death="false">
			<stack_type value="ignore" />
			<duration value="0" />
			<update_rate value="1" />
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odem" operation="add" value="@.cv700_odemRegen" />
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odem" operation="set" value="@cv700_odemMax"><requirement name="CVarCompare" cvar="cv700_odem" operation="GT" value="@cv700_odemMax" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="cv700_odem" operation="set" value="0"><requirement name="CVarCompare" cvar="cv700_odem" operation="LT" value="0" /></triggered_effect>

				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemZeigen" operation="set" value="0" />
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemZeigen" operation="set" value="1"><requirement name="CVarCompare" cvar="cv700_odemMax" operation="GT" value="0" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemAnteil" operation="set" value="0" />
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemAnteil" operation="set" value="@cv700_odem"><requirement name="CVarCompare" cvar="cv700_odemMax" operation="GT" value="0" /></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".cv700_odemAnteil" operation="divide" value="@cv700_odemMax"><requirement name="CVarCompare" cvar="cv700_odemMax" operation="GT" value="0" /></triggered_effect>
			</effect_group>
		</buff>

		<buff name="buff700_fluchSchwere" hidden="true">
			<stack_type value="replace" />
			<duration value="30" />
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-.15" />
				<passive_effect name="RunSpeed" operation="perc_add" value="-.15" />
			</effect_group>
		</buff>

	</append>

	<!-- WP10.6 (D182): Vanillas buffStatusCheck01 laeuft bei jedem Spieler immer (entityclasses
	     playerMale, Buffs; remove_on_death="false"). Eine eigene effect_group daran setzt die
	     zwei Odem-Buffs, wenn sie fehlen - beim ersten Betreten, nach dem Laden, nach dem Tod.
	     Ein Knoten aus Vanilla, also kein XPath ueber eine Modlet-Grenze (Vertrag 01 Teil 2b). -->
	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_odemStufe"><requirement name="!HasBuff" buff="buff700_odemStufe" /></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_odemRegen"><requirement name="!HasBuff" buff="buff700_odemRegen" /></triggered_effect>
		</effect_group>
	</append>
</config>
