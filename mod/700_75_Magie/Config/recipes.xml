<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_75_Magie / recipes.xml
	     F-15 Volksmagie, Plan-0002 WP10.4, D177

	     VON HAND GESCHRIEBEN.

	     'learnable' heisst: gesperrt, bis ein Perk die Marke mit dem Rezeptnamen setzt. Das
	     tut der Perk Runenritzen, Rang 1 (Runenkunde ab Stufe 2), in
	     700_50_Fortschritt/Config/progression.xml - die Bindung gehoert zum Baum (Vertrag 01
	     Teil 2b). Runenkreide und Glutstein sind NICHT gesperrt: wer die Bank hat, darf
	     sie fuellen, und ohne die Bank gibt es sie nicht. So steht die Bank nicht leer
	     (D57), auch bevor die Runen kommen (WP10.5). -->
	<append xpath="/recipes">

		<!-- Die Bank: ein Stumpf, Kreide gibt es noch nicht - also Holz, Steine, Naegel. An
		     der Zimmermannsbank, wie der Webstuhl. -->
		<recipe name="blk700_runenritzer" count="1" craft_area="workbench" craft_time="45" is_trackable="false" tags="learnable,workbenchCrafting">
			<ingredient name="resourceWood" count="40" />
			<ingredient name="resourceRockSmall" count="20" />
			<ingredient name="resourceNail" count="10" />
		</recipe>

		<!-- Die Werkzeuge: an der Esse, wie Vanillas Bratrost. -->
		<recipe name="itm700_ritzmesser" count="1" craft_area="forge" craft_time="30" is_trackable="false" tags="learnable">
			<ingredient name="resourceForgedIron" count="2" />
			<ingredient name="resourceWood" count="1" />
		</recipe>
		<recipe name="itm700_meissel" count="1" craft_area="forge" craft_time="30" is_trackable="false" tags="learnable">
			<ingredient name="resourceForgedIron" count="3" />
		</recipe>

		<!-- Die Grundstoffe: an der Bank selbst. Vier Kreiden aus einem Ansatz. -->
		<recipe name="itm700_runenkreide" count="4" craft_area="runenritzer" craft_time="10">
			<ingredient name="resourceCement" count="1" />
			<ingredient name="resourceClayLump" count="2" />
			<ingredient name="resourceCoal" count="1" />
		</recipe>
		<recipe name="itm700_glutstein" count="2" craft_area="runenritzer" craft_time="10">
			<ingredient name="resourceCoal" count="3" />
			<ingredient name="resourceAnimalFat" count="1" />
		</recipe>

		<!-- WP10.5a (D178): die fuenf Runen. An der Bank, mit dem Ritzmesser im Platz,
		     'learnable' - frei mit Runenritzen Rang 1 (Glut, Schutz, Wetter, Wanderschaft)
		     bzw. Bannkunde Rang 1 (Bann). Zutaten nach F-15 (D174), mit zwei Ersatzstoffen:
		     Bernstein gibt es noch nicht (F-05, Kennung offen) - die Bannrune nimmt Knochen;
		     Fell gibt es nicht - die Wetterrune nimmt Nesselfaser. Zu pruefen (N-122). -->
		<recipe name="itm700_glutrune" count="1" craft_area="runenritzer" craft_tool="itm700_ritzmesser" craft_time="20" is_trackable="false" tags="learnable">
			<ingredient name="itm700_runenkreide" count="2" />
			<ingredient name="itm700_glutstein" count="1" />
		</recipe>
		<recipe name="itm700_bannrune" count="1" craft_area="runenritzer" craft_tool="itm700_ritzmesser" craft_time="20" is_trackable="false" tags="learnable">
			<ingredient name="itm700_runenkreide" count="2" />
			<ingredient name="resourceBone" count="2" />
		</recipe>
		<recipe name="itm700_schutzrune" count="1" craft_area="runenritzer" craft_tool="itm700_ritzmesser" craft_time="20" is_trackable="false" tags="learnable">
			<ingredient name="itm700_runenkreide" count="2" />
			<ingredient name="resourceForgedIron" count="1" />
		</recipe>
		<recipe name="itm700_wetterrune" count="1" craft_area="runenritzer" craft_tool="itm700_ritzmesser" craft_time="20" is_trackable="false" tags="learnable">
			<ingredient name="itm700_runenkreide" count="2" />
			<ingredient name="resourceYuccaFibers" count="2" />
		</recipe>
		<recipe name="itm700_wanderrune" count="1" craft_area="runenritzer" craft_tool="itm700_ritzmesser" craft_time="20" is_trackable="false" tags="learnable">
			<ingredient name="itm700_runenkreide" count="2" />
			<ingredient name="resourceLeather" count="1" />
		</recipe>

		<!-- WP10.5b (D179): die vier Traenke in der Kraeuterkueche (chemistryStation),
		     'learnable' - frei beim Heiler ueber die Wundversorgung (craftingMedical,
		     700_50_Fortschritt). Nur Kraeuter und Hausmittel (F-15: "nur Material"), alles
		     Kennungen, die der Purge stehen laesst:
		     - Eulenauge: Heidelbeeren (Volksglaube: schaerfen den Blick im Dunkeln), Goldrute.
		     - Baerenmut: Honig und Pilze - der Berserker-Sud der Sage, hier zahm.
		     - Wolfsbalsam: Tierfett und Goldrute; die Goldrute hiess "heidnisch Wundkraut".
		     - Quellsud: Goldrute, Honig und eine Prise Runenkreide - der einzige Trank mit einem
		       Stoff des Runenkundigen, weil er dessen Odem fuellt.
		     Mengen sind Vorschlag (N-123). -->
		<recipe name="itm700_eulenauge" count="1" craft_area="chemistryStation" craft_time="20" is_trackable="false" tags="learnable,chemStationCrafting">
			<ingredient name="drinkJarBoiledWater" count="1" />
			<ingredient name="foodCropBlueberries" count="3" />
			<ingredient name="resourceCropGoldenrodPlant" count="1" />
		</recipe>
		<recipe name="itm700_baerenmut" count="1" craft_area="chemistryStation" craft_time="20" is_trackable="false" tags="learnable,chemStationCrafting">
			<ingredient name="drinkJarBoiledWater" count="1" />
			<ingredient name="foodHoney" count="1" />
			<ingredient name="foodCropMushrooms" count="2" />
		</recipe>
		<recipe name="itm700_wolfsbalsam" count="2" craft_area="chemistryStation" craft_time="20" is_trackable="false" tags="learnable,chemStationCrafting">
			<ingredient name="resourceAnimalFat" count="2" />
			<ingredient name="resourceCropGoldenrodPlant" count="2" />
		</recipe>
		<recipe name="itm700_quellsud" count="1" craft_area="chemistryStation" craft_time="30" is_trackable="false" tags="learnable,chemStationCrafting">
			<ingredient name="drinkJarBoiledWater" count="1" />
			<ingredient name="resourceCropGoldenrodPlant" count="2" />
			<ingredient name="foodHoney" count="1" />
			<ingredient name="itm700_runenkreide" count="1" />
		</recipe>

		<!-- WP10.5c (D180): Segen und Fluch.
		     - Geweihtes Wasser: an der Feuerstelle im Topf, fuer jeden, ohne Sperre - wie das
		       abgekochte Wasser, aus dem es wird. Die Kerze brennt beim Segnen herunter.
		     - Die zwei Segen: "gesprochen, nicht gebaut" - im Beutel, ohne Werkstatt,
		       'learnable', frei mit Bannkunde 1 (Segen der Wehr) bzw. 2 (Totensegen).
		     - Fluchtopf: an der Runenritzer-Bank, frei mit Bannkunde 1. Ein Tontopf aus Lehm,
		       mit Kreide bezeichnet, ein Knochen darin.
		     Mengen sind Vorschlag (N-124). -->
		<recipe name="itm700_weihwasser" count="1" craft_area="campfire" craft_tool="toolCookingPot" craft_time="15" is_trackable="false" tags="cookingPotFood">
			<ingredient name="drinkJarBoiledWater" count="1" />
			<ingredient name="candle" count="1" />
		</recipe>
		<recipe name="itm700_segenWehr" count="1" craft_time="5" is_trackable="false" tags="learnable">
			<ingredient name="itm700_weihwasser" count="1" />
		</recipe>
		<recipe name="itm700_totensegen" count="1" craft_time="5" is_trackable="false" tags="learnable">
			<ingredient name="itm700_weihwasser" count="1" />
			<ingredient name="candle" count="1" />
		</recipe>
		<recipe name="itm700_fluchtopf" count="1" craft_area="runenritzer" craft_time="15" is_trackable="false" tags="learnable">
			<ingredient name="resourceClayLump" count="2" />
			<ingredient name="itm700_runenkreide" count="1" />
			<ingredient name="resourceBone" count="1" />
		</recipe>

	</append>
</config>
