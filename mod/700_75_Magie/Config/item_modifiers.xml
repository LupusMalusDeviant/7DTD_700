<?xml version="1.0" encoding="UTF-8" ?>
<config>
	<!-- 700_75_Magie / item_modifiers.xml
	     F-15 Volksmagie, Plan-0002 WP10.5a, D174 (Zahlen), D178

	     VON HAND GESCHRIEBEN.

	     FUENF RUNEN ALS AUFSAETZE. Werte aus F-15 "Der Kern der Phase 2 in Zahlen" (D174):
	     hoechstens 15 % auf EINEN Wert (Balancing-Grundsatz). Alle Formen nach Vanilla:
	     - Glutrune:  triggered_effect AddBuff auf das Ziel mit RandomRoll, wie Vanillas
	                  perkPhysician (onSelfDamagedOther); der Brand ist buff700_brand (buffs.xml,
	                  Vertrag 07 Nachtrag 1, N1.4).
	     - Bannrune:  EntityDamage perc_add mit EntityTagCompare target=other tags=zombie, wie
	                  in Vanillas items.xml. Unsere Seuchentote sind Vanillas Klassen, umbenannt
	                  (F-06); die Marke 'zombie' tragen sie weiter.
	     - Schutz-, Wetterrune: perc_add auf den Wert des Teils. Vanillas Besatz nimmt base_add
	                  (+1, +2); perc_add soll mit dem Teil wachsen. [verifizieren im Spiel, S-37:
	                  rechnet das Spiel perc_add eines Aufsatzes auf den Wert des Teils?]
	     - Wanderrune: StaminaChangeOT perc_add tags="running,swimmingRun", wie Vanillas Perk
	                  perkRuleOneCardio, Rang 1 (+10 %) - hier +12 %.

	     EINE RUNE JE GEGENSTAND: alle tragen modifier_tags="rune700". Zwei Aufsaetze mit
	     derselben Marke schliessen sich aus (so haelt Vanilla zwei Laufaufsaetze auseinander).
	     type="attachment": eine Rune laesst sich wieder herausnehmen. Ob sie es soll, ist eine
	     Frage (N-122).

	     Kein UnlockedBy: gesperrt wird ueber das Rezept ('learnable', recipes.xml) und
	     freigeschaltet vom Baum der Runenkunde (700_50_Fortschritt). Bilder: Vanillas kleiner
	     Stein, je Rune getoent (F-16 spaeter). -->
	<append xpath="/item_modifiers">

		<item_modifier name="itm700_glutrune" installable_tags="melee" modifier_tags="rune700" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="resourceRockSmall" />
			<property name="CustomIconTint" value="e0703a" />
			<property name="DescriptionKey" value="itm700_glutruneDesc" />
			<property name="EconomicValue" value="150" />
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfDamagedOther" action="AddBuff" target="other" buff="buff700_brand">
					<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="12" />
					<requirement name="IsAlive" target="other" />
				</triggered_effect>
			</effect_group>
		</item_modifier>

		<item_modifier name="itm700_bannrune" installable_tags="melee,bow" modifier_tags="rune700" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="resourceRockSmall" />
			<property name="CustomIconTint" value="c8d8e8" />
			<property name="DescriptionKey" value="itm700_bannruneDesc" />
			<property name="EconomicValue" value="150" />
			<effect_group tiered="false">
				<passive_effect name="EntityDamage" operation="perc_add" value=".15">
					<requirement name="EntityTagCompare" target="other" tags="zombie" />
				</passive_effect>
			</effect_group>
		</item_modifier>

		<item_modifier name="itm700_schutzrune" installable_tags="armorChest" modifier_tags="rune700" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="resourceRockSmall" />
			<property name="CustomIconTint" value="a8b0b8" />
			<property name="DescriptionKey" value="itm700_schutzruneDesc" />
			<property name="DisplayType" value="modArmor" />
			<property name="EconomicValue" value="150" />
			<effect_group tiered="false">
				<passive_effect name="PhysicalDamageResist" operation="perc_add" value=".1" />
			</effect_group>
		</item_modifier>

		<item_modifier name="itm700_wetterrune" installable_tags="armorHead" modifier_tags="rune700" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="resourceRockSmall" />
			<property name="CustomIconTint" value="8fb8a0" />
			<property name="DescriptionKey" value="itm700_wetterruneDesc" />
			<property name="DisplayType" value="modArmor" />
			<property name="EconomicValue" value="150" />
			<effect_group tiered="false">
				<passive_effect name="HypothermalResist" operation="perc_add" value=".1" />
				<passive_effect name="HyperthermalResist" operation="perc_add" value=".1" />
			</effect_group>
		</item_modifier>

		<item_modifier name="itm700_wanderrune" installable_tags="armorFeet" modifier_tags="rune700" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="resourceRockSmall" />
			<property name="CustomIconTint" value="c8a878" />
			<property name="DescriptionKey" value="itm700_wanderruneDesc" />
			<property name="EconomicValue" value="150" />
			<effect_group tiered="false">
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".12" tags="running,swimmingRun" />
			</effect_group>
		</item_modifier>

	</append>
</config>
