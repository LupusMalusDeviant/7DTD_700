	<!-- ===========================================================================
	     DAS NAEHZEUG FLICKT, WAS NICHT AUS EISEN IST (D62, 8. November 2026)
	     ===========================================================================

	     D60 nennt ZWEI Reparatur-Gegenstaende, und beide sind fuer Metall: ein
	     Schleifstein schaerft eine Schneide, ein Schmiedeflicken setzt Eisen ein. Auf
	     einem Wollhemd liest sich beides falsch, und die fuenf Ruestungs-Basisklassen
	     zeigen alle auf das gesperrte resourceRepairKit - ohne Zutun waere unsere
	     ganze Ruestung unreparierbar.

	     resourceSewingKit steht schon als FREIGABE in der Denylist ("Nadel und Faden")
	     und traegt in Vanilla sogar die Tags armorLightSkill, armorMediumSkill und
	     armorHeavySkill. Es fehlen ihm aber zwei Dinge, und beide sind gemessen:

	       - KEIN REZEPT. In ganz recipes.xml kommt resourceSewingKit nicht als
	         Rezeptname vor; es gibt es nur aus Loot und beim Haendler. Das Rezept
	         steht darum in recipes.xml dieses Modlets.
	       - KEIN RepairAmount. Ein Gegenstand ohne diesen Wert gibt beim Reparieren
	         keine Haltbarkeit zurueck. 32000 ist Vanillas Zahl fuer "so viel, wie das
	         Stueck fassen kann" - uebernommen vom Reparatur-Kit.

	     WARUM VOLL UND NICHT TEILWEISE: D60s Teilung (Schleifstein teilweise, Flicken
	     voll an der Esse) haengt an der SCHNEIDE. Tuch und Leder naeht man ganz, dafuer
	     braucht man kein Feuer. Das Kettenhemd dagegen flickt der Schmiedeflicken, also
	     bleibt die Esse genau dort Bedingung, wo Eisen im Spiel ist. D62 ergaenzt D60,
	     es hebt es nicht auf.
	-->
	<append xpath="/items/item[@name='resourceSewingKit']">
		<property name="RepairAmount" value="32000" />
		<property name="RepairTime" value="4" />
	</append>

	<!-- Die fuenf Ruestungs-Basisklassen. armorDLCMaster steht mit dabei, obwohl kein
	     DLC-Teil erreichbar ist: ein Zeiger auf einen gesperrten Gegenstand ist ein
	     offener Faden, und ein offener Faden kostet hier eine Zeile. -->
	<set xpath="/items/item[@name='armorPrimitiveMaster']/property[@name='RepairTools']/@value">resourceSewingKit</set>
	<set xpath="/items/item[@name='armorLightMaster']/property[@name='RepairTools']/@value">resourceSewingKit</set>
	<set xpath="/items/item[@name='armorMediumMaster']/property[@name='RepairTools']/@value">resourceSewingKit</set>
	<set xpath="/items/item[@name='armorHeavyMaster']/property[@name='RepairTools']/@value">itm700_schmiedeflicken</set>
	<set xpath="/items/item[@name='armorDLCMaster']/property[@name='RepairTools']/@value">resourceSewingKit</set>

	<!-- Die vier Boegen und Armbrueste, die auf das gesperrte Reparatur-Kit zeigten
	     (D91, 22. November 2026 - zu pruefen durch den Nutzer). Gemessen an Vanilla
	     und am Dump vom selben Abend: jede der vier traegt RepairTools selbst, keine
	     erbt es. Der einfache Bogen (gunBowT0PrimitiveBow) flickt mit Holz und bleibt
	     so. -->
	<set xpath="/items/item[@name='gunBowT1WoodenBow']/property[@name='RepairTools']/@value">itm700_bogenzeug</set>
	<set xpath="/items/item[@name='gunBowT3CompoundBow']/property[@name='RepairTools']/@value">itm700_bogenzeug</set>
	<set xpath="/items/item[@name='gunBowT1IronCrossbow']/property[@name='RepairTools']/@value">itm700_bogenzeug</set>
	<set xpath="/items/item[@name='gunBowT3CompoundCrossbow']/property[@name='RepairTools']/@value">itm700_bogenzeug</set>

	<!-- Die fuenf Werkzeuge und partsMaster (Nachtlauf 22./23. November 2026 - ZU
	     PRUEFEN DURCH DEN NUTZER). Gemessen am Dump vom 22. November: Spitzhacke und
	     Schaufel je in Eisen und Stahl und der Klauenhammer zeigten als letzte
	     erreichbare Gegenstaende auf das Reparatur-Kit - jeder traegt RepairTools
	     selbst. Sie flicken jetzt wie die Waffen (D60): Schleifstein teilweise,
	     Schmiedeflicken ganz. partsMaster ist nicht erreichbar (CreativeMode None),
	     aber ein Zeiger auf einen gesperrten Gegenstand ist ein offener Faden.

	     DAMIT ZEIGT KEIN ERLAUBTER GEGENSTAND MEHR AUF resourceRepairKit (23 von 23),
	     und der Aufschub in tools/check/aufschub.txt ist eingeloest: das Reparatur-Kit
	     faellt mit dem Purge. -->
	<set xpath="/items/item[@name='meleeToolRepairT1ClawHammer']/property[@name='RepairTools']/@value">itm700_schleifstein,itm700_schmiedeflicken</set>
	<set xpath="/items/item[@name='meleeToolPickT1IronPickaxe']/property[@name='RepairTools']/@value">itm700_schleifstein,itm700_schmiedeflicken</set>
	<set xpath="/items/item[@name='meleeToolPickT2SteelPickaxe']/property[@name='RepairTools']/@value">itm700_schleifstein,itm700_schmiedeflicken</set>
	<set xpath="/items/item[@name='meleeToolShovelT1IronShovel']/property[@name='RepairTools']/@value">itm700_schleifstein,itm700_schmiedeflicken</set>
	<set xpath="/items/item[@name='meleeToolShovelT2SteelShovel']/property[@name='RepairTools']/@value">itm700_schleifstein,itm700_schmiedeflicken</set>
	<set xpath="/items/item[@name='partsMaster']/property[@name='RepairTools']/@value">itm700_schmiedeflicken</set>

	<!-- STAND DAVOR, als Verlauf: nach WP5.5 zeigten noch zehn erlaubte Gegenstaende
	     auf resourceRepairKit (vier Boegen, fuenf Werkzeuge, partsMaster), und der
	     Aufschub blieb stehen. Eine Pruefung, die "erlaubter Gegenstand repariert mit
	     gesperrtem Werkzeug" von selbst findet, gibt es weiter NICHT - gezaehlt ist am
	     Dump, mit einer Auswertung ausserhalb des Repositorys. Vermerkt in Vertrag 04
	     als offener Punkt. -->

</config>
