	     Lern-Buff, wenn er fehlt (wie die Odem-Buffs, 700_75_Magie, D182). -->
	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buff700_lernen"><requirement name="!HasBuff" buff="buff700_lernen" /></triggered_effect>
		</effect_group>
	</append>
</config>
