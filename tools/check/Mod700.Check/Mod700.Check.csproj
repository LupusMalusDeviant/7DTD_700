<Project Sdk="Microsoft.NET.Sdk">

  <!--
    mod700check - die drei Pruefwerkzeuge aus Vertrag 04.
    Kein Python (globale Regel), kein NuGet-Paket: nur die Standardbibliothek.
    Dasselbe Muster wie tools/meta/Mod700.Meta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mod700check</AssemblyName>
    <RootNamespace>Mod700.Check</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Dieses Werkzeug baut nicht gegen die Spiel-DLLs, SdtdPath ist hier ohne Belang. -->
  </PropertyGroup>

</Project>
