<?xml version="1.0" encoding="UTF-8" ?>
<!-- Pruefdaten fuer kette-pruefen.ps1: ein eigener Gegenstand. -->
<config>
	<append xpath="/items">
		<item name="itm700_pruefteil">
			<property name="Extends" value="pruefRohstoff" />
		</item>
	</append>

	<!-- Ein umgehaengtes Reparaturwerkzeug. Der Wert ist eine Kommaliste im Elementtext,
	     also kein Attribut und kein Rezept - die zweite Stelle, an der ein Tippfehler bis
	     WP6 unsichtbar blieb. -->
	<set xpath="/items/item[@name='pruefRohstoff']/property[@name='RepairTools']/@value">pruefWerkzeug,itm700_pruefteil</set>
</config>
