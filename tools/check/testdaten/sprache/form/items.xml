<config>
	<!-- Testdaten fuer sprachverweise-pruefen.ps1 (WP8.8): fuenf Patches an DescriptionKey
	     in einer Form, die die Pruefung nicht liest. Kein Spielinhalt. -->
	<append xpath="/items">
		<item name="pruef700_ding">
			<property name="DescriptionKey" value="pruef700_dingText"/>
		</item>
	</append>
	<set xpath="/items/item[starts-with(@name,'pruefTeil')]/property[@name='DescriptionKey']/@value">pruefGruppeDesc</set>
	<append xpath="/items/item[@name='pruefTeil' or @name='pruefDing']"><property name="DescriptionKey" value="pruefGruppeDesc"/></append>
	<remove xpath="/items/item[@name='pruefNotiz']/property[@name='DescriptionKey']"/>
	<setattribute xpath="/items/item[@name='pruefNotiz']/property[@name='DescriptionKey']" name="value">pruefLies</setattribute>
	<insertAfter xpath="/items/item[@name='pruefDing']/property[@name='Stacknumber']"><property name="DescriptionKey" value="pruefGruppeDesc"/></insertAfter>
</config>
