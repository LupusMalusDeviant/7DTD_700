<items>
	<!-- Testdaten fuer sprachverweise-pruefen.ps1 (WP8.8). Kein Spielinhalt. -->
	<item name="pruefTeilEltern">
		<property name="DescriptionKey" value="pruefGruppeDesc"/>
	</item>
	<!-- erbt den Beschreibungsschluessel -->
	<item name="pruefTeil">
		<property name="Extends" value="pruefTeilEltern"/>
	</item>
	<!-- erbt ihn NICHT: param1 schliesst ihn aus -->
	<item name="pruefTeilOhne">
		<property name="Extends" value="pruefTeilEltern" param1="CustomIcon,DescriptionKey"/>
	</item>
	<!-- liest 'pruefNotizDesc' ueber eine andere Eigenschaft als DescriptionKey -->
	<item name="pruefNotiz">
		<property name="DescriptionKey" value="pruefLies"/>
		<property class="Action0">
			<property name="PromptDescription" value="pruefNotizDesc"/>
		</property>
	</item>
	<item name="pruefDing">
		<property name="Stacknumber" value="1"/>
	</item>
</items>
